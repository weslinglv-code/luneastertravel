---
// Global floating PDF guide CTA — appears on all pages
// Shows on desktop (bottom-right corner) and mobile (bottom-right, above blog FAB if present)
---

<div class="floating-pdf-cta" id="floatingPdfCta">
  <a href="https://luneaster.gumroad.com" target="_blank" rel="noopener" class="floating-cta-btn">
    <span class="cta-icon">📄</span>
    <span class="cta-text">
      <span class="cta-title">PDF Travel Guides</span>
      <span class="cta-sub">Skip hours of research →</span>
    </span>
  </a>
</div>

<style>
  .floating-pdf-cta {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 90;
    transition: transform var(--t-normal), opacity var(--t-normal);
  }

  .floating-cta-btn {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 12px;
    padding: 0.625rem 1rem;
    box-shadow: 0 4px 16px rgba(26, 26, 46, 0.12);
    text-decoration: none;
    transition: all var(--t-fast);
    max-width: 260px;
  }

  .floating-cta-btn:hover {
    border-color: var(--c-accent);
    box-shadow: 0 6px 24px rgba(217, 74, 56, 0.15);
    transform: translateY(-2px);
  }

  .cta-icon {
    font-size: 1.4rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .cta-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .cta-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--c-text);
    white-space: nowrap;
  }

  .cta-sub {
    font-size: 0.7rem;
    color: var(--c-accent);
    font-weight: 500;
  }

  /* On mobile: smaller pill, positioned to not conflict with blog FAB */
  @media (max-width: 640px) {
    .floating-pdf-cta {
      bottom: 1rem;
      right: 1rem;
    }

    .floating-cta-btn {
      padding: 0.5rem 0.75rem;
      gap: 0.5rem;
      border-radius: 10px;
    }

    .cta-icon {
      font-size: 1.2rem;
    }

    .cta-title {
      font-size: 0.75rem;
    }

    .cta-sub {
      font-size: 0.65rem;
    }
  }

  /* When blog article mobile FAB is visible, shift this up */
  .floating-pdf-cta.shift-up {
    bottom: 4.5rem;
  }

  @media (max-width: 640px) {
    .floating-pdf-cta.shift-up {
      bottom: 4rem;
    }
  }
</style>

<script>
  // Show floating CTA after scrolling
  const floatingCta = document.getElementById('floatingPdfCta');
  if (floatingCta) {
    let visible = false;
    window.addEventListener('scroll', () => {
      const shouldShow = window.scrollY > 400;
      if (shouldShow && !visible) {
        floatingCta.style.opacity = '1';
        floatingCta.style.transform = 'translateY(0)';
        visible = true;
      } else if (!shouldShow && visible) {
        floatingCta.style.opacity = '0';
        floatingCta.style.transform = 'translateY(20px)';
        visible = false;
      }
    }, { passive: true });

    // Initial state: hidden
    floatingCta.style.opacity = '0';
    floatingCta.style.transform = 'translateY(20px)';

    // If blog article mobile FAB exists, shift this up when FAB is visible
    const blogFab = document.getElementById('mobileFabCta');
    if (blogFab) {
      const observer = new MutationObserver(() => {
        if (blogFab.classList.contains('visible')) {
          floatingCta.classList.add('shift-up');
        } else {
          floatingCta.classList.remove('shift-up');
        }
      });
      observer.observe(blogFab, { attributes: true, attributeFilter: ['class'] });
    }
  }
</script>
