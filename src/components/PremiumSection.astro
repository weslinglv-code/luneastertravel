---
import { premiumSection } from '../data/homepage';
import { products } from '../data/products';
import type { Product } from '../data/products';

const { sectionTitle, sectionSubtitle, buttonText, shopAllUrl, shopAllText } = premiumSection;

// Product cover art fallback (when no real image uploaded yet)
const coverArt: Record<string, { icon: string; pattern: string }> = {
  'japan-blueprint-7-day': { icon: 'mountain', pattern: 'fuji' },
  'tokyo-5-day-route': { icon: 'city', pattern: 'grid' },
  'tokyo-48hr-solo': { icon: 'clock', pattern: 'lines' },
  'kyoto-takao-three-temples': { icon: 'temple', pattern: 'leaves' },
  'kyoto-3-day-autumn': { icon: 'temple', pattern: 'leaves' },
  'okinawa-4day-slow-travel': { icon: 'mountain', pattern: 'fuji' },
  'wakayama-3day-mountain-sea': { icon: 'temple', pattern: 'leaves' },
};

function getArt(slug: string) {
  return coverArt[slug] || coverArt['tokyo-48hr-solo'];
}
---

<section class="section" id="premium">
  <div class="container">
    <div class="section-header">
      <h2>{sectionTitle}</h2>
      <p>{sectionSubtitle}</p>
    </div>

    <div class="product-grid">
      {products.map((product: Product) => {
        const art = getArt(product.slug);
        const hasImage = !!product.coverImage;
        return (
          <a href={product.gumroadUrl} class="product-card" style={`--accent: ${product.accentColor}`} target="_blank" rel="noopener">
            <div class="card-cover" data-pattern={art.pattern}>
              {hasImage ? (
                <img src={product.coverImage} alt={product.title} class="cover-img" loading="lazy" />
              ) : (
                <div class="cover-art">
                  {art.icon === 'mountain' && (
                    <svg viewBox="0 0 120 60" class="cover-icon" aria-hidden="true">
                      <path d="M0 55 L25 20 L40 35 L55 12 L80 40 L100 25 L120 50 L120 60 L0 60 Z" fill={product.accentColor} opacity="0.35"/>
                      <path d="M30 28 L38 38 L42 33 L50 42 L60 30 L70 40 L75 35 L85 45 L80 50 L30 50 Z" fill={product.accentColor} opacity="0.7"/>
                      <circle cx="85" cy="18" r="6" fill={product.accentColor} opacity="0.5"/>
                    </svg>
                  )}
                  {art.icon === 'city' && (
                    <svg viewBox="0 0 120 60" class="cover-icon" aria-hidden="true">
                      <rect x="10" y="25" width="12" height="35" fill={product.accentColor} opacity="0.35"/>
                      <rect x="25" y="15" width="15" height="45" fill={product.accentColor} opacity="0.5"/>
                      <rect x="44" y="20" width="10" height="40" fill={product.accentColor} opacity="0.4"/>
                      <rect x="58" y="5" width="20" height="55" fill={product.accentColor} opacity="0.6"/>
                      <rect x="82" y="18" width="14" height="42" fill={product.accentColor} opacity="0.45"/>
                      <rect x="100" y="28" width="10" height="32" fill={product.accentColor} opacity="0.35"/>
                    </svg>
                  )}
                  {art.icon === 'clock' && (
                    <svg viewBox="0 0 60 60" class="cover-icon" aria-hidden="true">
                      <circle cx="30" cy="30" r="24" fill="none" stroke={product.accentColor} stroke-width="2.5" opacity="0.4"/>
                      <circle cx="30" cy="30" r="18" fill={product.accentColor} opacity="0.2"/>
                      <line x1="30" y1="30" x2="30" y2="16" stroke={product.accentColor} stroke-width="2.5" opacity="0.7" stroke-linecap="round"/>
                      <line x1="30" y1="30" x2="42" y2="30" stroke={product.accentColor} stroke-width="2.5" opacity="0.7" stroke-linecap="round"/>
                      <circle cx="30" cy="30" r="2" fill={product.accentColor}/>
                    </svg>
                  )}
                  {art.icon === 'temple' && (
                    <svg viewBox="0 0 120 60" class="cover-icon" aria-hidden="true">
                      <rect x="57" y="6" width="6" height="5" fill={product.accentColor} opacity="0.9"/>
                      <circle cx="60" cy="4" r="2" fill={product.accentColor}/>
                      <rect x="36" y="11" width="48" height="5" fill={product.accentColor} opacity="0.85"/>
                      <rect x="42" y="16" width="36" height="9" fill={product.accentColor} opacity="0.6"/>
                      <rect x="30" y="25" width="60" height="6" fill={product.accentColor} opacity="0.75"/>
                      <rect x="38" y="31" width="44" height="8" fill={product.accentColor} opacity="0.55"/>
                      <rect x="24" y="39" width="72" height="6" fill={product.accentColor} opacity="0.7"/>
                      <rect x="32" y="45" width="56" height="11" fill={product.accentColor} opacity="0.5"/>
                    </svg>
                  )}
                </div>
              )}
              {product.badge && (
                <span class={`badge ${product.badge === 'Bestseller' ? 'badge-accent' : 'badge-new'}`}>
                  {product.badge}
                </span>
              )}
            </div>
            <div class="card-body">
              <h3>{product.title}</h3>
              <p class="card-subtitle">{product.subtitle}</p>
              <p class="card-desc">{product.description}</p>
              <div class="card-footer">
                <span class="price">{product.priceLabel}</span>
                <span class="pages">{product.pages} pages</span>
              </div>
              <div class="card-cta">{buttonText} →</div>
            </div>
          </a>
        );
      })}
    </div>

    <div class="shop-all-wrap">
      <a href={shopAllUrl} class="btn btn-primary" target="_blank" rel="noopener">
        {shopAllText} →
      </a>
    </div>
  </div>
</section>

<style>
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header p {
    margin-top: 0.5rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .product-card {
    display: block;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--t-normal);
    text-decoration: none;
    color: var(--c-text);
    height: 100%;
    box-shadow: var(--shadow-sm);
  }

  .product-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .card-cover {
    position: relative;
    height: 160px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 1.5rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, white), color-mix(in srgb, var(--accent) 4%, white));
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .card-cover .badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
  }

  .cover-art {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .cover-icon {
    width: 80%;
    height: auto;
    max-height: 80px;
  }

  .card-body {
    padding: 1.5rem;
  }

  .card-body h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--c-text);
    margin-bottom: 0.25rem;
  }

  .card-subtitle {
    font-size: 0.85rem;
    color: var(--accent);
    margin: 0 0 0.75rem 0;
    font-weight: 500;
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--c-text-muted);
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--c-border);
  }

  .price {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
  }

  .pages {
    font-size: 0.8rem;
    color: var(--c-text-muted);
  }

  .card-cta {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    transition: transform var(--t-fast);
  }

  .product-card:hover .card-cta {
    transform: translateX(4px);
  }

  .shop-all-wrap {
    text-align: center;
    margin-top: 3rem;
  }
</style>
