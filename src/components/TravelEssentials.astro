---
import { links } from '../data/affiliate-links.js';
import { essentials as essentialsData } from '../data/homepage';

const { sectionTitle, introText, disclosureText, viewAllText, viewAllUrl, buttons } = essentialsData;

const iconMap: Record<string, string> = {
  tp_flights: '✈️',
  booking_kyoto: '🏨',
  klook_jrpass: '🚄',
  klook_pocket_wifi: '📶',
  klook_tokyo_disney: '🎟️',
};

const items = (buttons || []).map(b => ({
  ...b,
  icon: iconMap[b.linkKey] || '🔗',
  link: links[b.linkKey],
})).filter(item => item.link);
---

<section class="essentials-section">
  <div class="container">
    <div class="essentials-header">
      <h2>{sectionTitle}</h2>
      <p class="essentials-intro">{introText}</p>
      <p class="essentials-disclosure">{disclosureText}</p>
    </div>

    <div class="essentials-grid">
      {items.map(item => (
        <a
          href={item.link.url}
          class="essential-card"
          target="_blank"
          rel="sponsored nofollow noopener"
        >
          <div class="essential-icon">{item.icon}</div>
          <div class="essential-body">
            <span class="essential-label">{item.label}</span>
            <span class="essential-brand">{item.link.brand}</span>
          </div>
          <span class="essential-arrow">→</span>
        </a>
      ))}
    </div>

    <div class="essentials-footer">
      <a href={viewAllUrl} class="btn-view-all">{viewAllText} →</a>
    </div>
  </div>
</section>

<style>
  .essentials-section {
    padding: 4rem 0;
    background: var(--c-surface-light);
  }

  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .essentials-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .essentials-header h2 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    color: var(--c-text);
    margin-bottom: 0.75rem;
  }

  .essentials-intro {
    font-size: 1.05rem;
    color: var(--c-text-muted);
    max-width: 560px;
    margin: 0 auto 0.5rem;
    line-height: 1.6;
  }

  .essentials-disclosure {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .essentials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .essential-card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    transition: all var(--t-fast);
    text-decoration: none;
    min-height: 72px;
  }

  .essential-card:hover {
    border-color: var(--c-accent);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(217, 74, 56, 0.08);
  }

  .essential-icon {
    font-size: 1.8rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .essential-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .essential-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-text);
  }

  .essential-brand {
    font-size: 0.75rem;
    color: var(--c-text-muted);
  }

  .essential-arrow {
    font-size: 1.2rem;
    color: var(--c-accent);
    flex-shrink: 0;
    transition: transform var(--t-fast);
  }

  .essential-card:hover .essential-arrow {
    transform: translateX(4px);
  }

  .essentials-footer {
    text-align: center;
    margin-top: 2rem;
  }

  .btn-view-all {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--c-text);
    transition: all var(--t-fast);
    text-decoration: none;
  }

  .btn-view-all:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  @media (max-width: 640px) {
    .essentials-grid {
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }

    .essential-card {
      padding: 1rem 1.25rem;
      min-height: 64px;
    }

    .essential-icon {
      font-size: 1.5rem;
    }
  }
</style>
