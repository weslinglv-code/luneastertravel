---
import { links } from '../data/affiliate-links.js';

const essentials = [
  { linkKey: 'tp_flights', label: 'Book Flights', icon: '✈️' },
  { linkKey: 'booking_kyoto', label: 'Resort Kyoto-Area Hotels', icon: '🏨' },
  { linkKey: 'klook_jrpass', label: 'Purchase your JR-Pass', icon: '🚄' },
  { linkKey: 'klook_pocket_wifi', label: 'Pocket-WiFi Rental', icon: '📶' },
  { linkKey: 'klook_tokyo_disney', label: 'Local Attraction Tickets', icon: '🎟️' },
];

const title = 'Recommended Japan Travel Essentials';
const intro = 'Save your time on travel bookings. I have gathered reliable booking resources for your Japanese trip.';
const disclosure = 'I will earn a tiny commission at zero-extra cost for you when you book via my links.';
---

<section class="essentials-section">
  <div class="container">
    <div class="essentials-header">
      <h2>{title}</h2>
      <p class="essentials-intro">{intro}</p>
      <p class="essentials-disclosure">{disclosure}</p>
    </div>

    <div class="essentials-grid">
      {essentials.map(item => {
        const link = links[item.linkKey];
        if (!link) return null;
        return (
          <a
            href={link.url}
            class="essential-card"
            target="_blank"
            rel="sponsored nofollow noopener"
          >
            <div class="essential-icon">{item.icon}</div>
            <div class="essential-body">
              <span class="essential-label">{item.label}</span>
              <span class="essential-brand">{link.brand}</span>
            </div>
            <span class="essential-arrow">→</span>
          </a>
        );
      })}
    </div>

    <div class="essentials-footer">
      <a href="/resources" class="btn-view-all">View All Resources →</a>
    </div>
  </div>
</section>

<style>
  .essentials-section {
    padding: 4rem 0;
    background: var(--c-surface-light);
  }

  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .essentials-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .essentials-header h2 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    color: var(--c-text);
    margin-bottom: 0.75rem;
  }

  .essentials-intro {
    font-size: 1.05rem;
    color: var(--c-text-muted);
    max-width: 560px;
    margin: 0 auto 0.5rem;
    line-height: 1.6;
  }

  .essentials-disclosure {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .essentials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .essential-card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    transition: all var(--t-fast);
    text-decoration: none;
    min-height: 72px;
  }

  .essential-card:hover {
    border-color: var(--c-accent);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(217, 74, 56, 0.08);
  }

  .essential-icon {
    font-size: 1.8rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .essential-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .essential-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-text);
  }

  .essential-brand {
    font-size: 0.75rem;
    color: var(--c-text-muted);
  }

  .essential-arrow {
    font-size: 1.2rem;
    color: var(--c-accent);
    flex-shrink: 0;
    transition: transform var(--t-fast);
  }

  .essential-card:hover .essential-arrow {
    transform: translateX(4px);
  }

  .essentials-footer {
    text-align: center;
    margin-top: 2rem;
  }

  .btn-view-all {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--c-text);
    transition: all var(--t-fast);
    text-decoration: none;
  }

  .btn-view-all:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  @media (max-width: 640px) {
    .essentials-grid {
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }

    .essential-card {
      padding: 1rem 1.25rem;
      min-height: 64px;
    }

    .essential-icon {
      font-size: 1.5rem;
    }
  }
</style>
