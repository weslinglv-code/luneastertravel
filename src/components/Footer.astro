---
import Logo from './Logo.astro';
import { footer } from '../data/homepage';

const { brandName, brandDescription, quickLinks, socialLinks, disclosure, copyright } = footer;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <Logo size={40} />
        <p>{brandDescription}</p>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <h4>Quick Links</h4>
          {quickLinks.map(link => (
            <a href={link.url}>{link.label}</a>
          ))}
        </div>
        <div class="footer-col">
          <h4>Social Media</h4>
          {socialLinks.map(link => (
            <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-disclosure">{disclosure}</p>
      <p class="copyright">{copyright}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-surface-light);
    border-top: 1px solid var(--c-border);
    margin-top: var(--space-2xl);
  }

  .footer-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-xl) 1.5rem var(--space-md);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: var(--space-lg);
  }

  .footer-brand {
    max-width: 320px;
  }

  .footer-brand :global(.logo) {
    margin-bottom: 0.75rem;
  }

  .footer-brand p {
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  .footer-links {
    display: flex;
    gap: 3rem;
  }

  .footer-col h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--c-text);
    margin-bottom: 0.75rem;
  }

  .footer-col a {
    display: block;
    color: var(--c-text-muted);
    font-size: 0.85rem;
    margin-bottom: 0.4rem;
    transition: color var(--t-fast);
  }

  .footer-col a:hover {
    color: var(--c-accent-light);
  }

  .footer-bottom {
    padding-top: var(--space-md);
    border-top: 1px solid var(--c-border);
  }

  .footer-disclosure {
    font-size: 0.78rem;
    color: var(--c-text-muted);
    text-align: center;
    line-height: 1.5;
    margin-bottom: 0.5rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .copyright {
    text-align: center;
    font-size: 0.8rem;
    color: var(--c-text-muted);
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .footer-top {
      flex-direction: column;
      gap: 2rem;
    }

    .footer-links {
      gap: 2rem;
    }
  }
</style>
