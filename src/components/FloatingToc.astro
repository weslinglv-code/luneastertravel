---
/**
 * FloatingToc.astro — 日系简约悬浮式博客目录
 *
 * 桌面端（≥1280px）：固定悬浮在正文左侧，浅米白半透明背景
 * 移动端（<1280px）：顶部按钮触发，左侧抽屉滑出
 *
 * Emoji 自动从 H2 标题文本开头提取（用 \p{Extended_Pictographic}）
 * 在 CMS 编辑 H2 标题时加 emoji 前缀即可自动显示在目录中
 * 示例: "## ✅ 10-Second Quick Summary" → 目录显示 "✅ 10-Second Quick Summary"
 */

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2);

// Parse emoji prefix from heading text
function parseEmojiHeading(text: string): { emoji: string; text: string } {
  // Match emoji at the start (supports most pictographic emojis)
  const match = text.match(/^(\p{Extended_Pictographic})\s*/u);
  if (match) {
    return { emoji: match[1], text: text.slice(match[0].length) };
  }
  return { emoji: '📝', text };
}

const parsedHeadings = tocHeadings.map((h) => ({
  slug: h.slug,
  ...parseEmojiHeading(h.text),
}));
---

{tocHeadings.length > 1 && (
  <>
    <!-- ===== Desktop: fixed floating TOC ===== -->
    <div class="floating-toc" id="floatingToc">
      <div class="toc-header">
        <div class="toc-title-group">
          <span class="toc-bar"></span>
          <span class="toc-title">Table of Contents</span>
        </div>
        <button class="toc-collapse-btn" id="tocCollapseBtn" aria-label="Collapse directory" type="button">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="toc-chevron">
            <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
      <nav class="toc-nav" id="tocNav">
        <ul>
          {parsedHeadings.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="toc-link">
                <span class="toc-emoji">{h.emoji}</span>
                <span class="toc-text">{h.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- ===== Mobile: trigger button + slide-out drawer ===== -->
    <button class="toc-mobile-trigger" id="tocMobileTrigger" type="button">
      <span class="toc-mobile-icon">📖</span>
      <span>Table of Contents</span>
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="toc-mobile-arrow">
        <path d="M4 3l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="toc-drawer-overlay" id="tocDrawerOverlay"></div>
    <aside class="toc-drawer" id="tocDrawer" aria-hidden="true">
      <div class="toc-drawer-header">
        <div class="toc-title-group">
          <span class="toc-bar"></span>
          <span class="toc-title">Table of Contents</span>
        </div>
        <button class="toc-drawer-close" id="tocDrawerClose" aria-label="Close directory" type="button">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <nav class="toc-drawer-nav">
        <ul>
          {parsedHeadings.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="toc-link" data-drawer-link>
                <span class="toc-emoji">{h.emoji}</span>
                <span class="toc-text">{h.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  </>
)}

<style>
  /* ===== Shared elements ===== */
  .toc-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toc-bar {
    display: inline-block;
    width: 3px;
    height: 14px;
    background: var(--c-accent, #d94a38);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .toc-title {
    font-family: Georgia, 'Times New Roman', 'Noto Serif JP', serif;
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: #3a3a3a;
  }

  .toc-link {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.25rem 0.35rem;
    font-size: 0.76rem;
    line-height: 1.4;
    color: var(--c-text-muted, #5f5f6e);
    text-decoration: none;
    border-radius: 5px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .toc-link:hover {
    color: #9c3a3a;
    background: rgba(217, 74, 56, 0.06);
  }

  .toc-emoji {
    font-size: 0.85rem;
    line-height: 1.4;
    flex-shrink: 0;
    width: 1.1rem;
    text-align: center;
  }

  .toc-text {
    flex: 1;
    min-width: 0;
  }

  .toc-nav ul,
  .toc-drawer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-nav li,
  .toc-drawer-nav li {
    margin: 0;
  }

  /* ===== Desktop floating TOC ===== */
  .floating-toc {
    display: none;
    position: fixed;
    left: 18px;
    top: 110px;
    width: auto;
    max-width: 175px;
    min-width: 130px;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    background: rgba(255, 252, 245, 0.8);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(232, 226, 214, 0.3);
    border-radius: 8px;
    padding: 0.5rem 0.45rem;
    z-index: 50;
    box-shadow: 0 1px 8px rgba(26, 26, 46, 0.04);
  }

  /* Custom scrollbar — subtle */
  .floating-toc::-webkit-scrollbar {
    width: 4px;
  }
  .floating-toc::-webkit-scrollbar-track {
    background: transparent;
  }
  .floating-toc::-webkit-scrollbar-thumb {
    background: rgba(232, 226, 214, 0.6);
    border-radius: 2px;
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    padding: 0 0.2rem;
  }

  .toc-collapse-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border: none;
    background: transparent;
    color: var(--c-text-muted, #5f5f6e);
    cursor: pointer;
    border-radius: 4px;
    transition: color 0.2s ease, background 0.2s ease;
    padding: 0;
  }

  .toc-collapse-btn:hover {
    color: #9c3a3a;
    background: rgba(217, 74, 56, 0.06);
  }

  .toc-chevron {
    transition: transform 0.25s ease;
  }

  /* Collapsed state */
  .floating-toc.collapsed .toc-nav {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    margin: 0;
    padding: 0;
  }

  .floating-toc.collapsed .toc-chevron {
    transform: rotate(-90deg);
  }

  .toc-nav {
    max-height: 1000px;
    opacity: 1;
    transition: max-height 0.3s ease, opacity 0.2s ease;
    overflow: hidden;
  }

  /* ===== Mobile trigger button ===== */
  .toc-mobile-trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(243, 239, 232, 0.7);
    border: 1px solid var(--c-border, #e8e2d6);
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    color: #3a3a3a;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
    margin-bottom: 1.5rem;
  }

  .toc-mobile-trigger:hover {
    background: rgba(243, 239, 232, 0.95);
    border-color: var(--c-accent, #d94a38);
  }

  .toc-mobile-icon {
    font-size: 1rem;
  }

  .toc-mobile-arrow {
    margin-left: auto;
    color: var(--c-text-muted, #5f5f6e);
  }

  /* ===== Mobile drawer ===== */
  .toc-drawer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(26, 26, 46, 0.35);
    backdrop-filter: blur(2px);
    z-index: 200;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .toc-drawer-overlay.active {
    display: block;
    opacity: 1;
  }

  .toc-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 280px;
    max-width: 85vw;
    background: #faf7f2;
    border-right: 1px solid var(--c-border, #e8e2d6);
    box-shadow: 4px 0 24px rgba(26, 26, 46, 0.12);
    z-index: 201;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
    padding: 1rem 0.75rem;
    visibility: hidden;
  }

  .toc-drawer.open {
    transform: translateX(0);
    visibility: visible;
  }

  .toc-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding: 0 0.375rem;
  }

  .toc-drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: var(--c-text-muted, #5f5f6e);
    cursor: pointer;
    border-radius: 4px;
    transition: color 0.2s ease, background 0.2s ease;
    padding: 0;
  }

  .toc-drawer-close:hover {
    color: #9c3a3a;
    background: rgba(217, 74, 56, 0.06);
  }

  .toc-drawer-nav .toc-link {
    padding: 0.6rem 0.75rem;
    font-size: 0.875rem;
  }

  /* ===== Responsive: show desktop floating TOC on wide screens ===== */
  @media (min-width: 1280px) {
    .floating-toc {
      display: block;
    }

    .toc-mobile-trigger {
      display: none;
    }

    /* Drawer never shows on desktop */
    .toc-drawer,
    .toc-drawer-overlay {
      display: none !important;
    }
  }
</style>

<script>
  // ===== Desktop: collapse / expand =====
  const floatingToc = document.getElementById('floatingToc');
  const collapseBtn = document.getElementById('tocCollapseBtn');

  if (floatingToc && collapseBtn) {
    collapseBtn.addEventListener('click', () => {
      floatingToc.classList.toggle('collapsed');
    });
  }

  // ===== Mobile: drawer open / close =====
  const mobileTrigger = document.getElementById('tocMobileTrigger');
  const drawer = document.getElementById('tocDrawer');
  const overlay = document.getElementById('tocDrawerOverlay');
  const closeBtn = document.getElementById('tocDrawerClose');

  function openDrawer() {
    if (!drawer || !overlay) return;
    drawer.classList.add('open');
    overlay.classList.add('active');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!drawer || !overlay) return;
    drawer.classList.remove('open');
    overlay.classList.remove('active');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  if (mobileTrigger) {
    mobileTrigger.addEventListener('click', openDrawer);
  }
  if (closeBtn) {
    closeBtn.addEventListener('click', closeDrawer);
  }
  if (overlay) {
    overlay.addEventListener('click', closeDrawer);
  }

  // Close drawer when clicking a link inside it
  const drawerLinks = document.querySelectorAll('[data-drawer-link]');
  drawerLinks.forEach((link) => {
    link.addEventListener('click', () => {
      setTimeout(closeDrawer, 150);
    });
  });

  // Close drawer on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && drawer.classList.contains('open')) {
      closeDrawer();
    }
  });
</script>
