---
import { blogSection } from '../data/homepage';
import { getCollection } from 'astro:content';
import { getImgInfoBatch } from '../utils/images';
import { TOPICS, CITIES, slugify } from '../data/blog-taxonomy';

const { sectionTitle, sectionSubtitle, maxPosts, buttonText, buttonUrl, englishOnly } = blogSection;

let posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Filter to English-only posts if enabled (hide Chinese-titled posts)
if (englishOnly) {
  posts = posts.filter(p => /^[\x00-\x7F]+$/.test(p.data.title));
}

const recentPosts = posts.slice(0, maxPosts || 3);
const postImgInfo = await getImgInfoBatch(recentPosts.map(p => p.data.coverImage));
---

{recentPosts.length > 0 && (
  <section class="section blog-section magazine">
    <div class="container">
      <div class="section-header">
        <h2>{sectionTitle}</h2>
        <p>{sectionSubtitle}</p>
      </div>
      <div class="taxonomy-links">
        <div class="tax-row">
          <span class="tax-label">Topics</span>
          {TOPICS.map((t) => <a href={`/topics/${slugify(t)}`} class="tax-link">{t}</a>)}
        </div>
        <div class="tax-row">
          <span class="tax-label">Cities</span>
          {CITIES.map((c) => <a href={`/cities/${slugify(c)}`} class="tax-link">{c}</a>)}
        </div>
      </div>
      <div class="blog-preview-grid">
        {recentPosts.map((post, idx) => (
          <a href={`/blog/${post.slug}`} class="blog-preview-card">
            {post.data.coverImage && (
              <div class="blog-cover">
                {postImgInfo[idx]?.webp ? (
                  <picture>
                    <source srcset={postImgInfo[idx].webp} type="image/webp" />
                    <img src={post.data.coverImage} alt={post.data.coverAlt || post.data.title} loading="lazy" width={postImgInfo[idx]?.width} height={postImgInfo[idx]?.height} />
                  </picture>
                ) : (
                  <img src={post.data.coverImage} alt={post.data.coverAlt || post.data.title} loading="lazy" width={postImgInfo[idx]?.width} height={postImgInfo[idx]?.height} />
                )}
              </div>
            )}
            <div class="blog-preview-tags">
              {post.data.tags.slice(0, 2).map(tag => <span class="tag">{tag}</span>)}
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="blog-preview-meta">
              <time>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</time>
              {post.data.readingTime && <span>· {post.data.readingTime}</span>}
            </div>
          </a>
        ))}
      </div>
      <div class="blog-cta">
        <a href={buttonUrl} class="btn btn-secondary">{buttonText} →</a>
      </div>
    </div>
  </section>
)}

<style>
  .blog-section {
    background: var(--c-bg);
    border-top: 1px solid var(--c-border);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header p {
    margin-top: 0.5rem;
  }

  .taxonomy-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--c-border);
  }

  .tax-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tax-label {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    min-width: 52px;
  }

  .tax-link {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    text-decoration: none;
    transition: color var(--t-fast);
  }

  .tax-link:hover {
    color: var(--c-accent);
    text-decoration: underline;
  }

  /* C3: magazine layout — first post featured (2/3 width), others stacked right */
  .blog-preview-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .blog-preview-card {
    display: flex;
    flex-direction: column;
    background: transparent;
    border: none;
    border-radius: 0;
    overflow: hidden;
    transition: all var(--t-normal);
    text-decoration: none;
    color: var(--c-text);
  }

  .blog-preview-card:hover {
    transform: translateY(-3px);
  }

  .blog-preview-card:first-child {
    grid-column: 1;
    grid-row: 1 / span 2;
  }

  .blog-preview-card:nth-child(2) {
    grid-column: 2;
    grid-row: 1;
  }

  .blog-preview-card:nth-child(3) {
    grid-column: 2;
    grid-row: 2;
  }

  .blog-cover {
    width: 100%;
    height: 150px;
    overflow: hidden;
  }

  .blog-preview-card:first-child .blog-cover {
    height: 360px;
  }

  .blog-cover picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .blog-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-preview-tags {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    padding: 1rem 0 0;
  }

  .blog-preview-card .tag {
    background: transparent;
    color: var(--c-accent);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0;
  }

  .blog-preview-card h3 {
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
    color: var(--c-text);
    line-height: 1.3;
    padding: 0;
  }

  .blog-preview-card:first-child h3 {
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .blog-preview-card p {
    color: var(--c-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    flex: 1;
    line-height: 1.5;
    padding: 0;
  }

  .blog-preview-card:first-child p {
    font-size: 0.95rem;
  }

  .blog-preview-meta {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    display: flex;
    gap: 0.4rem;
    padding: 0;
  }

  /* Mobile fallback: single column, equal cards */
  @media (max-width: 768px) {
    .blog-preview-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .blog-preview-card:first-child,
    .blog-preview-card:nth-child(2),
    .blog-preview-card:nth-child(3) {
      grid-column: 1;
      grid-row: auto;
    }
    .blog-preview-card:first-child .blog-cover {
      height: 200px;
    }
    .blog-preview-card:first-child h3 {
      font-size: 1.3rem;
    }
  }

  .blog-cta {
    text-align: center;
  }
</style>
