---
import { blogSection } from '../data/homepage';
import { getCollection } from 'astro:content';

const { sectionTitle, sectionSubtitle, maxPosts, buttonText, buttonUrl, englishOnly } = blogSection;

let posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Filter to English-only posts if enabled (hide Chinese-titled posts)
if (englishOnly) {
  posts = posts.filter(p => /^[\x00-\x7F]+$/.test(p.data.title));
}

const recentPosts = posts.slice(0, maxPosts || 3);
---

{recentPosts.length > 0 && (
  <section class="section blog-section">
    <div class="container">
      <div class="section-header">
        <h2>{sectionTitle}</h2>
        <p>{sectionSubtitle}</p>
      </div>
      <div class="blog-preview-grid">
        {recentPosts.map(post => (
          <a href={`/blog/${post.slug}`} class="blog-preview-card">
            {post.data.coverImage && (
              <div class="blog-cover">
                <img src={post.data.coverImage} alt={post.data.coverAlt || post.data.title} loading="lazy" />
              </div>
            )}
            <div class="blog-preview-tags">
              {post.data.tags.slice(0, 2).map(tag => <span class="tag">{tag}</span>)}
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="blog-preview-meta">
              <time>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</time>
              {post.data.readingTime && <span>· {post.data.readingTime}</span>}
            </div>
          </a>
        ))}
      </div>
      <div class="blog-cta">
        <a href={buttonUrl} class="btn btn-secondary">{buttonText} →</a>
      </div>
    </div>
  </section>
)}

<style>
  .blog-section {
    background: var(--c-surface-light);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header p {
    margin-top: 0.5rem;
  }

  .blog-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .blog-preview-card {
    display: flex;
    flex-direction: column;
    background: var(--c-surface);
    border-radius: var(--radius-md);
    border: 1px solid var(--c-border);
    overflow: hidden;
    transition: all var(--t-normal);
    text-decoration: none;
    color: var(--c-text);
  }

  .blog-preview-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .blog-cover {
    width: 100%;
    height: 160px;
    overflow: hidden;
  }

  .blog-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-preview-tags {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    padding: 1rem 1.5rem 0;
  }

  .blog-preview-card .tag {
    background: var(--c-accent-bg, rgba(217, 74, 56, 0.1));
    color: var(--c-accent);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 99px;
  }

  .blog-preview-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--c-text);
    line-height: 1.3;
    padding: 0 1.5rem;
  }

  .blog-preview-card p {
    color: var(--c-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    flex: 1;
    line-height: 1.5;
    padding: 0 1.5rem;
  }

  .blog-preview-meta {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    display: flex;
    gap: 0.4rem;
    padding: 0 1.5rem 1.5rem;
  }

  .blog-cta {
    text-align: center;
  }
</style>
