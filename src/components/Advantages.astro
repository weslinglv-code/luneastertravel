---
import { advantages } from '../data/homepage';

const { sectionTitle, sectionSubtitle, cards } = advantages;
const visibleCards = cards.filter(c => c.visible !== false);

const iconMap: Record<string, string> = {
  route: '🗺️',
  yen: '¥',
  pin: '📍',
  transit: '🚄',
  mountain: '⛰️',
  clock: '🕐',
  map: '🗺️',
  star: '⭐',
};
---

<section class="section why-section">
  <div class="container">
    <div class="section-header">
      <h2>{sectionTitle}</h2>
      <p>{sectionSubtitle}</p>
    </div>
    <div class="why-grid">
      {visibleCards.map(card => (
        <div class="why-item">
          <div class="why-icon">{iconMap[card.icon] || '⭐'}</div>
          <h3>{card.title}</h3>
          <p>{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-section {
    background: var(--c-surface-light);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header p {
    margin-top: 0.5rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }

  .why-item {
    text-align: center;
    background: var(--c-surface);
    padding: 2rem 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--c-border);
    transition: all var(--t-normal);
  }

  .why-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .why-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .why-item h3 {
    margin-bottom: 0.5rem;
  }
</style>
