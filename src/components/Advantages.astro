---
import { advantages } from '../data/homepage';

const { sectionTitle, sectionSubtitle, cards } = advantages;
const visibleCards = cards.filter(c => c.visible !== false);

const iconSvg: Record<string, string> = {
  map: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12 L17 9 L31 13 L39 10 L39 36 L31 39 L17 35 L9 38 Z"/><path d="M17 9 L17 35"/><path d="M31 13 L31 39"/><circle cx="23" cy="21" r="2" fill="currentColor" stroke="none"/><circle cx="23" cy="30" r="2" fill="currentColor" stroke="none"/><path d="M23 23 L23 28"/></svg>`,
  yen: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="18"/><path d="M16 16 L24 26 L32 16"/><path d="M14 26 L34 26"/><path d="M14 31 L34 31"/><path d="M24 26 L24 36"/></svg>`,
  pin: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 6 C17 6 12 11 12 18 C12 26 24 38 24 38 C24 38 36 26 36 18 C36 11 31 6 24 6 Z"/><circle cx="24" cy="18" r="4"/></svg>`,
  transit: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="10" y="8" width="28" height="24" rx="4"/><path d="M10 20 L38 20"/><circle cx="16" cy="30" r="2" fill="currentColor" stroke="none"/><circle cx="32" cy="30" r="2" fill="currentColor" stroke="none"/><path d="M14 38 L10 42"/><path d="M34 38 L38 42"/><rect x="14" y="12" width="8" height="6" rx="1"/><rect x="26" y="12" width="8" height="6" rx="1"/></svg>`,
  route: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12 L17 9 L31 13 L39 10 L39 36 L31 39 L17 35 L9 38 Z"/><path d="M17 9 L17 35"/><path d="M31 13 L31 39"/><circle cx="23" cy="21" r="2" fill="currentColor" stroke="none"/><circle cx="23" cy="30" r="2" fill="currentColor" stroke="none"/><path d="M23 23 L23 28"/></svg>`,
  mountain: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 38 L18 16 L26 28 L32 20 L42 38 Z"/><circle cx="34" cy="12" r="3"/></svg>`,
  clock: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="18"/><path d="M24 14 L24 24 L32 28"/></svg>`,
  star: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 8 L29 19 L41 20 L32 28 L35 40 L24 33 L13 40 L16 28 L7 20 L19 19 Z"/></svg>`,
};
---

<section class="section why-section">
  <div class="container">
    <div class="section-header">
      <h2>{sectionTitle}</h2>
      <p>{sectionSubtitle}</p>
    </div>
    <div class="why-grid">
      {visibleCards.map(card => (
        <div class="why-item">
          <div class="why-icon" set:html={iconSvg[card.icon] || iconSvg.star}></div>
          <h3>{card.title}</h3>
          <p>{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-section {
    background: var(--c-surface-light);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header p {
    margin-top: 0.5rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }

  .why-item {
    text-align: center;
    background: var(--c-surface);
    padding: 2.75rem 1.75rem 2.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--c-border);
    transition: all var(--t-normal);
  }

  .why-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .why-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 2.25rem;
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .why-icon :global(svg) {
    width: 48px;
    height: 48px;
    display: block;
  }

  .why-item h3 {
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .why-item p {
    color: #888;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }
</style>
