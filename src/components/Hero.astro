---
import { hero } from '../data/homepage';
import { addGumroadUtm } from '../utils/tracking';

const { bgImage, tag, title, titleHighlight, subtitle, trustBadges, primaryButton, secondaryButton } = hero;

// Split title to highlight the keyword
const titleParts = titleHighlight
  ? title.split(new RegExp(`(${titleHighlight})`, 'i'))
  : [title];

// Append UTM params to any Gumroad CTA so GA4 can attribute each button
const withUtm = (url: string, content: string) =>
  url.includes('gumroad.com') ? addGumroadUtm(url, content) : url;

const primaryUrl = withUtm(primaryButton.url, 'hero_primary');
const secondaryUrl = withUtm(secondaryButton.url, 'hero_secondary');
---

<section class="hero">
  <div class="container hero-content">
    <span class="hero-tag">{tag}</span>
    <h1>
      {titleParts.map((part, i) => (
        part.toLowerCase() === (titleHighlight || '').toLowerCase()
          ? <em key={i}>{part}</em>
          : <Fragment key={i}>{part}</Fragment>
      ))}
    </h1>
    <p class="hero-desc">{subtitle}</p>
    <div class="hero-cta">
      <a href={primaryUrl} class="btn btn-primary" target="_blank" rel="noopener">
        {primaryButton.text}
      </a>
      <a href={secondaryUrl} class="hero-textlink" target="_blank" rel="noopener">
        {secondaryButton.text}
      </a>
    </div>
    <div class="hero-stats">
      {trustBadges.map(badge => (
        <div class="stat">
          <span class="stat-num">{badge.num}</span>
          <span class="stat-label">{badge.label}</span>
        </div>
      ))}
    </div>
  </div>
  <figure class="hero-figure">
    <img src={bgImage} alt="Snow-covered Japanese mountain village in winter" width="1800" height="958" loading="eager" fetchpriority="high" />
    <figcaption class="hero-caption">Gokayama, Toyama — the roofs hold a metre of snow</figcaption>
  </figure>
</section>

<style>
  .hero {
    background: var(--c-bg);
  }

  .hero-content {
    padding: 5.5rem 1.5rem 4rem;
    max-width: var(--container);
    margin: 0 auto;
    text-align: left;
  }

  .hero-tag {
    display: block;
    font-size: 0.72rem;
    color: var(--c-accent);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-bottom: 2.25rem;
    font-weight: 500;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6.4vw, 4.75rem);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -0.005em;
    color: var(--c-text);
    max-width: 15ch;
    margin-bottom: 2rem;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--c-accent);
  }

  .hero-desc {
    font-size: 1.05rem;
    max-width: 46ch;
    color: var(--c-text-muted);
    margin-bottom: 2.75rem;
    line-height: 1.85;
  }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    flex-wrap: wrap;
  }

  .hero-cta .btn-primary {
    background: var(--c-primary);
    color: #fff;
    border: 1px solid var(--c-primary);
    border-radius: var(--radius-sm);
    box-shadow: none;
    letter-spacing: 0.06em;
  }

  .hero-cta .btn-primary:hover {
    background: var(--c-accent);
    border-color: var(--c-accent);
    box-shadow: none;
  }

  .hero-textlink {
    font-size: 0.88rem;
    color: var(--c-text);
    text-decoration: none;
    border-bottom: 1px solid var(--c-border);
    padding-bottom: 3px;
    transition: border-color var(--t-fast), color var(--t-fast);
  }

  .hero-textlink:hover {
    color: var(--c-accent);
    border-bottom-color: var(--c-accent);
  }

  .hero-stats {
    display: flex;
    gap: 3.5rem;
    margin-top: 4rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--c-border);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--c-text);
  }

  .stat-label {
    font-size: 0.7rem;
    color: var(--c-text-muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-figure {
    position: relative;
    margin: 0;
    width: 100%;
  }

  .hero-figure img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 74vh;
    object-fit: cover;
  }

  .hero-caption {
    position: absolute;
    left: 1.5rem;
    bottom: 1.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.65);
  }

  @media (max-width: 640px) {
    .hero-content {
      padding: 3.5rem 1.5rem 3rem;
    }

    .hero-tag {
      font-size: 0.66rem;
      letter-spacing: 0.22em;
      margin-bottom: 1.5rem;
    }

    .hero-desc {
      font-size: 0.98rem;
      line-height: 1.75;
      margin-bottom: 2rem;
    }

    .hero-cta {
      gap: 1.5rem;
    }

    .hero-cta .btn-primary {
      width: 100%;
      justify-content: center;
    }

    .hero-stats {
      gap: 1.75rem;
      margin-top: 3rem;
    }

    .stat-num {
      font-size: 1.25rem;
    }

    .stat-label {
      font-size: 0.62rem;
      letter-spacing: 0.1em;
    }

    .hero-figure img {
      max-height: 56vh;
    }

    .hero-caption {
      left: 1rem;
      bottom: 0.85rem;
      font-size: 0.64rem;
    }
  }
</style>