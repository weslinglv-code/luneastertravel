---
import Logo from './Logo.astro';
import { navigation } from '../data/homepage';

const { menu, shopButton } = navigation;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo" aria-label="LuneAster home">
      <Logo size={40} />
    </a>

    <nav class="nav-desktop">
      {menu.map(link => (
        <a href={link.url}>{link.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a href={shopButton.url} class="btn-shop" target="_blank" rel="noopener">
        {shopButton.text}
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <nav class="nav-mobile" id="navMobile">
    {menu.map(link => (
      <a href={link.url}>{link.label}</a>
    ))}
    <a href={shopButton.url} class="btn-shop-mobile" target="_blank" rel="noopener">
      {shopButton.text}
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--c-border);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-logo {
    flex-shrink: 0;
  }

  .nav-desktop {
    display: flex;
    gap: 1.75rem;
    align-items: center;
    flex: 1;
    justify-content: center;
  }

  .nav-desktop a {
    color: var(--c-text-muted);
    font-size: 0.88rem;
    font-weight: 500;
    transition: color var(--t-fast);
    white-space: nowrap;
  }

  .nav-desktop a:hover {
    color: var(--c-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .btn-shop {
    background: var(--c-accent);
    color: white !important;
    padding: 0.6rem 1.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
    transition: all var(--t-fast);
    white-space: nowrap;
  }

  .btn-shop:hover {
    background: var(--c-accent-light);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(217, 74, 56, 0.3);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--c-text);
    border-radius: 2px;
    transition: all var(--t-fast);
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    padding: 0 1.5rem 1rem;
    gap: 0.5rem;
  }

  .nav-mobile a {
    color: var(--c-text-muted);
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--c-border);
    font-weight: 500;
    font-size: 0.95rem;
    min-height: 48px;
    display: flex;
    align-items: center;
  }

  .nav-mobile .btn-shop-mobile {
    background: var(--c-accent);
    color: white !important;
    text-align: center;
    border-radius: var(--radius-sm);
    border: none;
    padding: 0.75rem;
    font-weight: 600;
  }

  .nav-mobile.open {
    display: flex;
  }

  @media (max-width: 900px) {
    .nav-desktop { display: none; }
    .nav-toggle { display: flex; }
    .header-inner { padding: 0.5rem 1rem; }
    .btn-shop {
      padding: 0.7rem 1.1rem;
      font-size: 0.82rem;
      min-height: 44px;
      display: flex;
      align-items: center;
    }
  }

  @media (max-width: 480px) {
    .btn-shop {
      padding: 0.65rem 0.9rem;
      font-size: 0.78rem;
    }
    .header-logo :global(svg) {
      width: 32px !important;
      height: 32px !important;
    }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const mobile = document.getElementById('navMobile');
  toggle?.addEventListener('click', () => {
    mobile?.classList.toggle('open');
  });
</script>
