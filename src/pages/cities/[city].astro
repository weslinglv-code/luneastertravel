---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getImgInfoBatch } from '../../utils/images';
import { products } from '../../data/products';
import { CITIES, CITY_PRODUCTS, slugify, cityIntro } from '../../data/blog-taxonomy';

export async function getStaticPaths() {
  return CITIES.map((c) => ({
    params: { city: slugify(c) },
    props: { cityName: c },
  }));
}

interface Props {
  cityName: string;
}

const { cityName } = Astro.props;
const citySlug = slugify(cityName);

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const posts = allPosts.filter((p) => (p.data.city || '') === cityName);
const imgInfo = await getImgInfoBatch(posts.map((p) => p.data.coverImage));

const intro = cityIntro(citySlug) || `Japan travel guides for ${cityName}.`;

const slugs = citySlug === 'japan' ? products.map((p) => p.slug) : (CITY_PRODUCTS[citySlug] || []);
const cityProducts = products.filter((p) => slugs.includes(p.slug));
---

<Layout
  title={`${cityName} Travel Guides | LuneAster Travel`}
  description={intro}
>
  <section class="tax-page">
    <div class="container">
      <a href="/topics/" class="back-link">&larr; All Topics &amp; Cities</a>
      <header class="tax-header">
        <p class="eyebrow">City</p>
        <h1>{cityName}</h1>
        <p class="lede">{intro}</p>
      </header>

      {posts.length > 0 && (
        <div class="post-grid">
          {posts.map((post, idx) => (
            <a href={`/blog/${post.slug}`} class="post-card">
              {post.data.coverImage && (
                <div class="post-cover">
                  {imgInfo[idx]?.webp ? (
                    <picture>
                      <source srcset={imgInfo[idx].webp} type="image/webp" />
                      <img src={post.data.coverImage} alt={post.data.coverAlt || post.data.title} loading="lazy" width={imgInfo[idx]?.width} height={imgInfo[idx]?.height} />
                    </picture>
                  ) : (
                    <img src={post.data.coverImage} alt={post.data.coverAlt || post.data.title} loading="lazy" width={imgInfo[idx]?.width} height={imgInfo[idx]?.height} />
                  )}
                </div>
              )}
              <div class="post-body">
                <div class="post-tags">
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <div class="card-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                  {post.data.readingTime && <span>· {post.data.readingTime}</span>}
                </div>
              </div>
            </a>
          ))}
        </div>
      )}

      {cityProducts.length > 0 && (
        <div class="pdf-block">
          <h2>PDF itineraries for {cityName}</h2>
          <p class="pdf-sub">Printable, hour-by-hour routes you can follow offline.</p>
          <div class="pdf-grid">
            {cityProducts.map((p) => (
              <a href={`/products/${p.slug}`} class="pdf-card">
                <div class="pdf-thumb" style={`background-image:url('${p.coverImage}')`}></div>
                <div class="pdf-info">
                  <h3>{p.title}</h3>
                  <p>{p.subtitle}</p>
                  <div class="pdf-meta">
                    <span class="pdf-price">{p.priceLabel}</span>
                    <span>{p.pages} pages</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .tax-page { padding: 3rem 0 4rem; }
  .container { max-width: var(--container); margin: 0 auto; padding: 0 1.5rem; }
  .back-link { display: inline-block; color: var(--c-text-muted); font-size: 0.875rem; font-weight: 500; margin-bottom: 1.5rem; transition: color var(--t-fast); }
  .back-link:hover { color: var(--c-accent); }
  .tax-header { margin-bottom: 2.5rem; }
  .eyebrow { font-size: 0.72rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--c-text-muted); margin: 0 0 0.5rem; }
  .tax-header h1 { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); font-weight: 500; color: var(--c-text); margin: 0 0 0.75rem; letter-spacing: -0.01em; }
  .lede { color: var(--c-text-muted); font-size: 1.05rem; max-width: 60ch; line-height: 1.7; }

  .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 3rem; }
  .post-card { display: flex; flex-direction: column; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius-md); overflow: hidden; text-decoration: none; color: var(--c-text); transition: transform var(--t-fast), box-shadow var(--t-fast); }
  .post-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-sm); }
  .post-cover { width: 100%; aspect-ratio: 16/9; overflow: hidden; }
  .post-cover picture, .post-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .post-body { padding: 1.25rem; display: flex; flex-direction: column; flex: 1; }
  .post-tags { display: flex; gap: 0.4rem; margin-bottom: 0.5rem; }
  .tag { background: var(--c-accent-bg); color: var(--c-accent); font-size: 0.7rem; font-weight: 600; padding: 0.2rem 0.5rem; border-radius: 99px; }
  .post-body h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--c-text); line-height: 1.3; }
  .post-body p { color: var(--c-text-muted); font-size: 0.9rem; margin-bottom: 0.75rem; flex: 1; line-height: 1.5; }
  .card-meta { font-size: 0.8rem; color: var(--c-text-muted); display: flex; gap: 0.4rem; }

  .pdf-block { border-top: 1px solid var(--c-border); padding-top: 2.5rem; }
  .pdf-block h2 { font-family: var(--font-display); font-size: 1.75rem; font-weight: 500; color: var(--c-text); margin-bottom: 0.25rem; }
  .pdf-sub { color: var(--c-text-muted); margin-bottom: 1.75rem; }
  .pdf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
  .pdf-card { display: flex; flex-direction: column; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius-md); overflow: hidden; text-decoration: none; color: var(--c-text); transition: transform var(--t-fast), box-shadow var(--t-fast); }
  .pdf-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-sm); }
  .pdf-thumb { width: 100%; aspect-ratio: 16/9; background-size: cover; background-position: center; background-color: var(--c-surface-light); }
  .pdf-info { padding: 1.25rem; }
  .pdf-info h3 { font-size: 1.05rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--c-text); }
  .pdf-info p { color: var(--c-text-muted); font-size: 0.85rem; margin-bottom: 0.75rem; line-height: 1.5; }
  .pdf-meta { display: flex; align-items: center; gap: 0.75rem; }
  .pdf-price { font-size: 1.15rem; font-weight: 700; color: var(--c-accent); }
  .pdf-meta span:last-child { font-size: 0.8rem; color: var(--c-text-muted); }
</style>
