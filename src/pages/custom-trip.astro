---
import Layout from '../layouts/Layout.astro';
import { links } from '../data/affiliate-links.js';

// Build affiliate links for auto-reply email
const affiliateLinksText = [
  `Book Flights: ${links.tp_flights.url}`,
  `Book Hotels (Kyoto Area): ${links.booking_kyoto.url}`,
  `Purchase JR Pass: ${links.klook_jrpass.url}`,
  `Pocket WiFi Rental: ${links.klook_pocket_wifi.url}`,
  `Tokyo Attraction Tickets: ${links.klook_tokyo_disney.url}`,
  `Travel Adapter: ${links.amazon_adapter.url}`,
  `Portable Charger: ${links.amazon_powerbank.url}`,
  `Japan Guidebook: ${links.amazon_guidebook.url}`,
].join('\n');

const autoResponseSubject = 'Your Custom Japan-Trip Request Has Been Received | LuneAster';

const autoResponseText = `Thank you for your inquiry!

I will reply to your email within 24 hours with custom-made travel suggestions.

In the meantime, here are some booking resources for your Japan trip:

${affiliateLinksText}

Happy travels!
LuneAster Travel`;
---

<Layout
  title="Custom Trip — Bespoke Japan Travel Itinerary"
  description="Request a personalized Japan travel itinerary crafted by a travel designer. Tell us your preferences and get a tailored plan within 24 hours."
  ogImage="/images/custom-trip-og.jpg"
>
  <section class="page-hero">
    <div class="container-narrow">
      <span class="hero-tag">☽ Custom Trip</span>
      <h1>Request Your Bespoke Japan Travel Itinerary</h1>
      <p class="lead">
        Tired of generic online travel guides?<br />
        Send over your travel demands via the form below. I will craft a one-of-a-kind
        travel plan tailored for your Japan getaway.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <!-- Form -->
      <div class="form-wrapper" id="formSection">
        <p class="form-hint">
          Your email address is required so I can get back to you with personalised travel advice.
        </p>

        <form id="customTripForm" class="custom-form">
          <!-- FormSubmit.co hidden fields -->
          <input type="hidden" name="_subject" value="New Custom Trip Inquiry" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_autoresponse" value={autoResponseText} />

          <div class="form-group full">
            <label for="email">Your Email <span class="required">*</span></label>
            <input type="email" id="email" name="email" required placeholder="you@example.com" />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="dates">Planned Travel Date</label>
              <input type="text" id="dates" name="planned_travel_date" placeholder="e.g. Oct 15 - Oct 22, 2026" />
            </div>
            <div class="form-group">
              <label for="travelers">Number Of Travellers</label>
              <select id="travelers" name="number_of_travellers">
                <option value="">Select...</option>
                <option value="1">1 person</option>
                <option value="2">2 people</option>
                <option value="3">3 people</option>
                <option value="4">4 people</option>
                <option value="5+">5+ people</option>
              </select>
            </div>
          </div>

          <div class="form-group full">
            <label for="destinations">Target Japanese Cities</label>
            <input type="text" id="destinations" name="target_cities" placeholder="e.g. Tokyo, Kyoto, Osaka, Hakone..." />
          </div>

          <div class="form-group full">
            <label for="interests">Trip Style</label>
            <input type="text" id="interests" name="trip_style" placeholder="e.g. Food, temples, anime, shopping, nature, nightlife..." />
          </div>

          <div class="form-group full">
            <label for="notes">Additional Requirements</label>
            <textarea id="notes" name="additional_requirements" rows="5" placeholder="Tell me anything else about your trip — dietary restrictions, accessibility needs, must-see places, etc."></textarea>
          </div>

          <button type="submit" class="btn-submit">
            Send My Request →
          </button>

          <p class="form-disclaimer">
            By submitting this form, you agree to our
            <a href="/privacy">Privacy Policy</a>. Your information will never be shared with third parties.
          </p>
        </form>
      </div>

      <!-- Success message (hidden by default) -->
      <div class="success-message" id="successMessage" style="display: none;">
        <div class="success-icon">✓</div>
        <h2>Thank you, I will email you shortly</h2>
        <p>
          I can also share budget-friendly hotel, transport and portable-wifi booking resources for your trip.
        </p>
        <div class="success-actions">
          <a href="/" class="btn btn-secondary">Back to Home</a>
          <a href="/blog" class="btn btn-primary">Read Free Guides</a>
        </div>
      </div>

      <!-- Error message -->
      <div class="error-message" id="errorMessage" style="display: none;">
        <p>Something went wrong. Please try again or email me directly at
          <a href="mailto:luneaster17@gmail.com">luneaster17@gmail.com</a>.</p>
      </div>
    </div>
  </section>

  <!-- Trust indicators -->
  <section class="trust-section">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item">
          <div class="trust-icon">⏱️</div>
          <h3>24-Hour Response</h3>
          <p>Get a personalised reply within 24 hours of submitting your request.</p>
        </div>
        <div class="trust-item">
          <div class="trust-icon">🗾</div>
          <h3>Local Expertise</h3>
          <p>Itineraries built from real on-the-ground experience in Japan.</p>
        </div>
        <div class="trust-item">
          <div class="trust-icon">💰</div>
          <h3>Budget-Conscious</h3>
          <p>Every recommendation includes cost breakdowns and money-saving tips.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 5rem 0 2rem;
    text-align: center;
  }

  .hero-tag {
    display: block;
    color: var(--c-accent);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--c-text-muted);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto;
  }

  .section {
    padding: 2rem 0 4rem;
  }

  .container-narrow {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .form-wrapper {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 16px;
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .form-hint {
    font-size: 0.9rem;
    color: var(--c-text-muted);
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    background: var(--c-accent-bg);
    border-radius: 8px;
    border-left: 3px solid var(--c-accent);
  }

  .custom-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: flex;
    gap: 1.25rem;
  }

  .form-group {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .form-group.full {
    width: 100%;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-text);
    margin-bottom: 0.4rem;
  }

  .required {
    color: var(--c-accent);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: var(--font-sans);
    background: var(--c-bg);
    color: var(--c-text);
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
    min-height: 48px;
  }

  .form-group textarea {
    min-height: 120px;
    resize: vertical;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--c-accent);
    box-shadow: 0 0 0 3px rgba(217, 74, 56, 0.1);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #aaa;
  }

  .btn-submit {
    background: var(--c-accent);
    color: white;
    border: none;
    padding: 0.875rem 2rem;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 700;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: all var(--t-fast);
    min-height: 52px;
    margin-top: 0.5rem;
  }

  .btn-submit:hover {
    background: var(--c-accent-light);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(217, 74, 56, 0.3);
  }

  .btn-submit:active {
    transform: translateY(0);
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .form-disclaimer {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    text-align: center;
    margin-top: 0.5rem;
    line-height: 1.5;
  }

  .form-disclaimer a {
    color: var(--c-accent);
    text-decoration: underline;
  }

  /* Success message */
  .success-message {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 16px;
    box-shadow: var(--shadow-md);
  }

  .success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--c-success);
    color: white;
    font-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }

  .success-message h2 {
    margin-bottom: 1rem;
  }

  .success-message p {
    color: var(--c-text-muted);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  .success-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  /* Error message */
  .error-message {
    text-align: center;
    padding: 2rem;
    background: rgba(217, 74, 56, 0.05);
    border: 1px solid rgba(217, 74, 56, 0.2);
    border-radius: 12px;
    margin-top: 1.5rem;
  }

  .error-message a {
    color: var(--c-accent);
    text-decoration: underline;
  }

  /* Trust section */
  .trust-section {
    padding: 3rem 0;
    background: var(--c-surface-light);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .trust-item {
    text-align: center;
  }

  .trust-icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .trust-item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }

  .trust-item p {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    line-height: 1.5;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .form-wrapper {
      padding: 1.5rem 1.25rem;
    }

    .form-row {
      flex-direction: column;
      gap: 1rem;
    }

    .btn-submit {
      width: 100%;
    }

    .trust-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .success-actions {
      flex-direction: column;
    }

    .success-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  const form = document.getElementById('customTripForm');
  const formSection = document.getElementById('formSection');
  const successMessage = document.getElementById('successMessage');
  const errorMessage = document.getElementById('errorMessage');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('.btn-submit');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    try {
      const formData = new FormData(form);
      const response = await fetch('https://formsubmit.co/ajax/luneaster17@gmail.com', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: formData
      });

      if (response.ok) {
        formSection.style.display = 'none';
        successMessage.style.display = 'block';
        successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        throw new Error('Submission failed');
      }
    } catch (err) {
      errorMessage.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send My Request →';
    }
  });
</script>
