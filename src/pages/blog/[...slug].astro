---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FloatingToc from '../../components/FloatingToc.astro';
import { products } from '../../data/products';
import { articleCta } from '../../data/homepage';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const { title, description, pubDate, updatedDate, coverImage, coverAlt, tags, author, readingTime } = post.data;

// Fetch related posts (exclude current, prioritize shared tags, limit to 3)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug)
  .map(p => ({
    post: p,
    sharedTags: (p.data.tags || []).filter((t: string) => tags.includes(t)).length,
  }))
  .sort((a, b) => b.sharedTags - a.sharedTags || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map(item => item.post);

// Pre-compute WebP paths for related post cover images
const relatedImgInfo = await Promise.all(
  relatedPosts.map(rp => getImgInfo(rp.data.coverImage))
);

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siteUrl = 'https://luneastertravel.com';
const articleUrl = `${siteUrl}/blog/${post.slug}.html`;

// Helper: get image dimensions + WebP path for template <picture> tags
async function getImgInfo(src) {
  if (!src) return { width: null, height: null, webp: null };
  const { existsSync } = await import('fs');
  const { join } = await import('path');
  const sharp = (await import('sharp')).default;
  const filePath = join(process.cwd(), 'public', src.replace(/^\//, ''));
  let width = null, height = null;
  try {
    if (existsSync(filePath)) {
      const meta = await sharp(filePath).metadata();
      width = meta.width || null;
      height = meta.height || null;
    }
  } catch (e) { /* ignore */ }
  // Check for WebP version
  let webp = null;
  if (/\.(jpg|jpeg|png)$/i.test(src)) {
    const webpSrc = src.replace(/\.(jpg|jpeg|png)$/i, '.webp');
    const webpPath = join(process.cwd(), 'public', webpSrc.replace(/^\//, ''));
    if (existsSync(webpPath)) webp = webpSrc;
  }
  return { width, height, webp };
}

const coverImgInfo = await getImgInfo(coverImage);

// Get the sidebar & end-CTA products from CMS-editable config (not hardcoded)
const sidebarProduct = products.find(p => p.slug === articleCta.sidebar.product_slug) || products[0];
const endRecommendation = products.find(p => p.slug === articleCta.end_cta.product_slug) || products[0];
const sidebarCfg = articleCta.sidebar;
const endCtaCfg = articleCta.end_cta;
const lightCtaCfg = articleCta.light_cta;
const midCtaCfg = articleCta.mid_cta;

// JSON-LD structured data for SEO
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'LuneAster Travel',
    url: siteUrl,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  url: articleUrl,
  keywords: tags.join(', '),
};
---

<Layout title={title} description={description} ogImage={coverImage}>
  <article class="article">
    <div class="blog-container">
      <div class="blog-grid">
        <FloatingToc headings={headings} mode="desktop" />
        <!-- Main article column -->
        <div class="article-main">
        <a href="/blog.html" class="back-link">&larr; All Articles</a>

        <header class="article-header">
          {tags && tags.length > 0 && (
            <div class="article-tags">
              {tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          )}
          <h1>{title}</h1>
          <div class="article-meta">
            <span class="meta-author">{author}</span>
            <span class="meta-sep">&middot;</span>
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            {readingTime && (
              <>
                <span class="meta-sep">&middot;</span>
                <span class="meta-reading">{readingTime}</span>
              </>
            )}
          </div>
        </header>

        {coverImage && (
          <div class="article-cover">
            {coverImgInfo.webp ? (
              <picture>
                <source srcset={coverImgInfo.webp} type="image/webp" />
                <img src={coverImage} alt={coverAlt || title} loading="eager" width={coverImgInfo.width} height={coverImgInfo.height} />
              </picture>
            ) : (
              <img src={coverImage} alt={coverAlt || title} loading="eager" width={coverImgInfo.width} height={coverImgInfo.height} />
            )}
          </div>
        )}

        <FloatingToc headings={headings} mode="mobile" />

        <div class="article-body">
          <Content />
        </div>

        <!-- End-of-article conversion block with direct Gumroad link -->
        <div class="article-end-cta">
          <div class="end-cta-label">{endCtaCfg.label}</div>
          <div class="end-cta-product">
            <div class="end-cta-info">
              <h3>{endRecommendation.title}</h3>
              <p>{endRecommendation.subtitle}</p>
              <div class="end-cta-meta">
                <span class="end-cta-price">{endRecommendation.priceLabel}</span>
                <span class="end-cta-pages">{endRecommendation.pages} pages</span>
                {endRecommendation.badge && <span class="end-cta-badge">{endRecommendation.badge}</span>}
              </div>
            </div>
            <a href={endRecommendation.gumroadUrl} class="end-cta-btn" target="_blank" rel="noopener">
              {endCtaCfg.cta_text}
            </a>
          </div>
          <a href={endCtaCfg.secondary_url} class="end-cta-secondary">{endCtaCfg.secondary_text}</a>
        </div>

        {relatedPosts.length > 0 && (
          <div class="related-articles">
            <h3 class="related-title">Related Japan Travel Guides</h3>
            <div class="related-grid">
              {relatedPosts.map((rp, idx) => (
                <a href={`/blog/${rp.slug}.html`} class="related-card">
                  {rp.data.coverImage && (
                    <div class="related-cover">
                      {relatedImgInfo[idx]?.webp ? (
                        <picture>
                          <source srcset={relatedImgInfo[idx].webp} type="image/webp" />
                          <img
                            src={rp.data.coverImage}
                            alt={rp.data.coverAlt || rp.data.title}
                            loading="lazy"
                            width={relatedImgInfo[idx]?.width}
                            height={relatedImgInfo[idx]?.height}
                          />
                        </picture>
                      ) : (
                        <img
                          src={rp.data.coverImage}
                          alt={rp.data.coverAlt || rp.data.title}
                          loading="lazy"
                          width={relatedImgInfo[idx]?.width}
                          height={relatedImgInfo[idx]?.height}
                        />
                      )}
                    </div>
                  )}
                  <div class="related-body">
                    {rp.data.tags.slice(0, 1).map(tag => <span class="related-tag">{tag}</span>)}
                    <h4>{rp.data.title}</h4>
                    <p>{rp.data.description}</p>
                    <span class="related-read">
                      {rp.data.readingTime || '5 min read'}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Sticky sidebar with persistent product card (desktop only) -->
      <aside class="article-sidebar">
        <div class="sidebar-sticky">
          <div class="sidebar-product-card">
            <div class="sidebar-card-label">{sidebarCfg.label}</div>
            <h4>{sidebarProduct.title}</h4>
            <p class="sidebar-card-sub">{sidebarProduct.subtitle}</p>
            <div class="sidebar-card-price">
              <span class="price">{sidebarProduct.priceLabel}</span>
              {sidebarProduct.badge && <span class="sidebar-badge">{sidebarProduct.badge}</span>}
            </div>
            <ul class="sidebar-features">
              {sidebarProduct.features.slice(0, 3).map(f => <li>{f}</li>)}
            </ul>
            <a href={sidebarProduct.gumroadUrl} class="sidebar-cta" target="_blank" rel="noopener">
              {sidebarCfg.cta_text}
            </a>
            <div class="sidebar-trust">{sidebarCfg.trust_text}</div>
          </div>

          <div class="sidebar-newsletter">
            <h4>{sidebarCfg.newsletter_heading}</h4>
            <p>{sidebarCfg.newsletter_body}</p>
            <a href={sidebarCfg.newsletter_url} target="_blank" rel="noopener" class="sidebar-tiktok">
              {sidebarCfg.newsletter_cta}
            </a>
          </div>
        </div>
      </aside>
      </div>
    </div>
  </article>

  <!-- Mobile floating CTA bar (appears after scrolling) -->
  <div class="mobile-fab-cta" id="mobileFabCta">
    <a href={midCtaCfg.url} target="_blank" rel="noopener">
      <span class="fab-text">{midCtaCfg.button_text}</span>
      <span class="fab-arrow">&rarr;</span>
    </a>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<style>
  .article {
    padding: 1.5rem 0 4rem;
  }

  .blog-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .blog-grid {
    display: flex;
    flex-direction: column;
  }

  .article-main {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }

  .back-link {
    display: inline-block;
    color: var(--c-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    transition: color var(--t-fast);
  }

  .back-link:hover {
    color: var(--c-accent);
  }

  .article-header {
    margin-bottom: 1.5rem;
  }

  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .tag {
    background: var(--c-accent-bg);
    color: var(--c-accent);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .article-header h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--c-text);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-text-muted);
    font-size: 0.875rem;
    flex-wrap: wrap;
  }

  .meta-sep {
    opacity: 0.5;
  }

  .article-cover {
    margin: 0 0 1.5rem;
    border-radius: 12px;
    overflow: hidden;
  }

  .article-cover picture {
    display: block;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16/9;
    object-fit: cover;
  }

  /* ===== Desktop: three-column layout =====
     TOC (210px) + 2rem gap + content (max 720px) + 2rem gap + sidebar (280px)
     Centered within 1280px container, TOC stays close to content not far left.
  */
  @media (min-width: 1024px) {
    .blog-grid {
      flex-direction: row;
      gap: 2rem;
      align-items: flex-start;
    }
  }

  @media (min-width: 1280px) {
    .blog-grid {
      justify-content: center;
    }
  }

  /* ===== Article Body ===== */
  .article-body {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--c-text);
  }

  .article-body :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2.75rem 0 1rem;
    padding-left: 1rem;
    border-left: 3px solid var(--c-accent);
    color: var(--c-text);
    scroll-margin-top: 100px;
    line-height: 1.3;
  }

  .article-body :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    color: var(--c-primary);
    scroll-margin-top: 100px;
    line-height: 1.35;
  }

  .article-body :global(p) {
    margin-bottom: 1.25rem;
    max-width: 68ch;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.25rem 1.5rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--c-accent);
    padding: 0.5rem 0 0.5rem 1.25rem;
    margin: 1.5rem 0;
    color: var(--c-text-muted);
    font-style: italic;
    background: var(--c-surface-light);
    border-radius: 0 8px 8px 0;
  }

  .article-body :global(strong) {
    font-weight: 700;
    color: var(--c-text);
  }

  .article-body :global(picture) {
    display: block;
    margin: 1.5rem 0;
  }

  .article-body :global(picture img) {
    border-radius: 8px;
    margin: 0;
    max-width: 100%;
    height: auto;
  }

  .article-body :global(img) {
    border-radius: 8px;
    margin: 1.5rem 0;
    max-width: 100%;
    height: auto;
  }

  .article-body :global(a) {
    color: var(--c-accent);
    text-decoration: underline;
    text-decoration-color: rgba(232, 93, 74, 0.3);
    text-underline-offset: 3px;
  }

  .article-body :global(a:hover) {
    text-decoration-color: var(--c-accent);
  }

  /* ===== Table styling — rounded cards ===== */
  .article-body :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 1.5rem 0;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .article-body :global(thead th) {
    background: var(--c-primary);
    color: #fff;
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.875rem 1.25rem;
    text-align: left;
  }

  .article-body :global(thead th:first-child) {
    border-top-left-radius: 12px;
  }

  .article-body :global(thead th:last-child) {
    border-top-right-radius: 12px;
  }

  .article-body :global(tbody td) {
    padding: 0.875rem 1.25rem;
    border-top: 1px solid var(--c-border);
    font-size: 0.925rem;
    line-height: 1.5;
  }

  .article-body :global(tbody tr:nth-child(even)) {
    background: var(--c-surface-light);
  }

  .article-body :global(tbody tr:hover) {
    background: var(--c-accent-bg);
  }

  .article-body :global(tbody tr:last-child td:first-child) {
    border-bottom-left-radius: 12px;
  }

  .article-body :global(tbody tr:last-child td:last-child) {
    border-bottom-right-radius: 12px;
  }

  /* ===== Inline CTA blocks (injected by rehype plugin) ===== */
  /* Lightweight mid-article CTA hint */
  .article-body :global(.cta-light-hint) {
    background: linear-gradient(135deg, rgba(217, 74, 56, 0.05) 0%, var(--c-surface) 60%);
    border: 1px solid rgba(217, 74, 56, 0.12);
    border-left: 3px solid var(--c-accent);
    border-radius: 10px;
    padding: 1.125rem 1.5rem;
    margin: 2rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .article-body :global(.cta-light-hint p) {
    margin: 0;
    font-size: 0.925rem;
    color: var(--c-text);
    line-height: 1.5;
    flex: 1;
    min-width: 200px;
    font-weight: 450;
  }

  .article-body :global(.cta-light-link) {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-accent) !important;
    text-decoration: none !important;
    padding: 0.5rem 1.125rem;
    border: 1.5px solid var(--c-accent);
    border-radius: 8px;
    transition: all var(--t-fast);
  }

  .article-body :global(.cta-light-link:hover) {
    background: var(--c-accent);
    color: #fff !important;
  }

  /* Full button CTA block (mid-article PDF guide promotion) */
  .article-body :global(.cta-button-block) {
    background: linear-gradient(135deg, var(--c-primary) 0%, #2a2a4a 100%);
    border-radius: 14px;
    padding: 1.75rem 2rem;
    margin: 2.25rem 0;
    text-align: center;
  }

  .article-body :global(.cta-button-block p) {
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
  }

  .article-body :global(.cta-orange-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--c-accent);
    color: #fff !important;
    padding: 0.875rem 2.25rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none !important;
    transition: all var(--t-fast);
    min-height: 48px;
  }

  .article-body :global(.cta-orange-btn:hover) {
    background: var(--c-accent-light);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(217, 74, 56, 0.4);
  }

  /* ===== End-of-article conversion block ===== */
  .article-end-cta {
    margin: 3rem 0 1.5rem;
    padding: 2rem;
    background: linear-gradient(135deg, var(--c-accent-bg) 0%, var(--c-surface) 60%);
    border: 1px solid var(--c-border);
    border-left: 4px solid var(--c-accent);
    border-radius: 14px;
  }

  .end-cta-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-accent);
    margin-bottom: 1rem;
  }

  .end-cta-product {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .end-cta-info h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--c-text);
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }

  .end-cta-info p {
    color: var(--c-text-muted);
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    max-width: 68ch;
  }

  .end-cta-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .end-cta-price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--c-accent);
  }

  .end-cta-pages {
    font-size: 0.8rem;
    color: var(--c-text-muted);
  }

  .end-cta-badge {
    background: var(--c-accent);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 99px;
    text-transform: uppercase;
  }

  .end-cta-btn {
    display: inline-flex;
    align-items: center;
    background: var(--c-accent);
    color: white !important;
    padding: 0.875rem 1.75rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: 1rem;
    white-space: nowrap;
    transition: all var(--t-fast);
    min-height: 48px;
  }

  .end-cta-btn:hover {
    background: var(--c-accent-light);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(217, 74, 56, 0.35);
  }

  .end-cta-secondary {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--c-text-muted);
    font-weight: 500;
    transition: color var(--t-fast);
  }

  .end-cta-secondary:hover {
    color: var(--c-accent);
  }

  /* ===== Related Articles ===== */
  .related-articles {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid var(--c-border);
  }

  .related-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--c-text);
    margin-bottom: 1.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 12px;
    overflow: hidden;
    transition: transform var(--t-fast), box-shadow var(--t-fast);
    text-decoration: none;
  }

  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .related-cover {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .related-cover picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .related-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .related-tag {
    background: var(--c-accent-bg);
    color: var(--c-accent);
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
    text-transform: uppercase;
    align-self: flex-start;
  }

  .related-body h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--c-text);
    line-height: 1.3;
  }

  .related-body p {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-read {
    font-size: 0.75rem;
    color: var(--c-text-muted);
    margin-top: auto;
  }

  @media (max-width: 768px) {
    .related-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .related-card {
      flex-direction: row;
    }

    .related-cover {
      width: 120px;
      aspect-ratio: 1;
      flex-shrink: 0;
    }

    .related-body {
      flex: 1;
    }

    .related-body p {
      -webkit-line-clamp: 1;
    }
  }

  /* ===== Sidebar ===== */
  .article-sidebar {
    display: none;
    width: 300px;
    flex-shrink: 0;
  }

  .sidebar-sticky {
    position: sticky;
    top: 90px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-product-card {
    background: white;
    border: 1px solid var(--c-border);
    border-radius: 14px;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .sidebar-card-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-accent);
    margin-bottom: 0.75rem;
  }

  .sidebar-product-card h4 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--c-text);
    margin-bottom: 0.25rem;
  }

  .sidebar-card-sub {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    margin-bottom: 0.75rem;
  }

  .sidebar-card-price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .sidebar-card-price .price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--c-accent);
  }

  .sidebar-badge {
    background: var(--c-accent);
    color: white;
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
    text-transform: uppercase;
  }

  .sidebar-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem 0;
    font-size: 0.82rem;
    color: var(--c-text-muted);
    line-height: 1.5;
  }

  .sidebar-features li {
    padding-left: 1.25rem;
    position: relative;
    margin-bottom: 0.4rem;
  }

  .sidebar-features li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--c-accent);
    font-weight: 700;
  }

  .sidebar-cta {
    display: block;
    text-align: center;
    background: var(--c-accent);
    color: white !important;
    padding: 0.75rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.9rem;
    transition: all var(--t-fast);
    min-height: 48px;
    line-height: 32px;
  }

  .sidebar-cta:hover {
    background: var(--c-accent-light);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(217, 74, 56, 0.3);
  }

  .sidebar-trust {
    text-align: center;
    font-size: 0.72rem;
    color: var(--c-text-muted);
    margin-top: 0.75rem;
  }

  .sidebar-newsletter {
    background: var(--c-accent-bg);
    border-radius: 14px;
    padding: 1.25rem;
    text-align: center;
  }

  .sidebar-newsletter h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--c-text);
    margin-bottom: 0.5rem;
  }

  .sidebar-newsletter p {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    margin-bottom: 0.75rem;
  }

  .sidebar-tiktok {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-accent);
    text-decoration: none;
  }

  .sidebar-tiktok:hover {
    text-decoration: underline;
  }

  /* ===== Mobile floating CTA bar ===== */
  .mobile-fab-cta {
    display: none;
  }

  /* Desktop: show sidebar */
  @media (min-width: 1024px) {
    .article-sidebar {
      display: block;
    }
  }

  /* Tablet: cover retains its margin */
  @media (min-width: 768px) {
    .article-cover {
      margin: 0 0 2rem;
    }
  }

  /* Mobile optimizations */
  @media (max-width: 640px) {
    .article {
      padding: 1rem 0 5rem;
    }

    .article-end-cta {
      padding: 1.25rem;
    }

    .end-cta-product {
      flex-direction: column;
      align-items: stretch;
    }

    .end-cta-btn {
      text-align: center;
      justify-content: center;
    }

    /* Table: make scrollable on small screens */
    .article-body :global(table) {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
    }

    .article-body :global(thead) {
      display: table-header-group;
    }

    .article-body :global(tbody) {
      display: table;
      width: 100%;
    }

    /* Inline CTA: stack vertically */
    .article-body :global(.cta-light-hint) {
      flex-direction: column;
      align-items: stretch;
    }

    .article-body :global(.cta-light-link) {
      text-align: center;
    }

    .article-body :global(.cta-button-block) {
      padding: 1.25rem 1rem;
    }

    /* Mobile floating CTA bar */
    .mobile-fab-cta {
      display: block;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: var(--c-surface);
      border-top: 1px solid var(--c-border);
      box-shadow: 0 -4px 20px rgba(26, 26, 46, 0.1);
      padding: 0.625rem 1rem;
      transform: translateY(100%);
      transition: transform var(--t-normal);
    }

    .mobile-fab-cta.visible {
      transform: translateY(0);
    }

    .mobile-fab-cta a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: var(--c-accent);
      color: #fff !important;
      padding: 0.75rem 1.5rem;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.9rem;
      text-decoration: none !important;
      min-height: 48px;
    }

    .mobile-fab-cta a:active {
      background: var(--c-accent-light);
    }

    .fab-arrow {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  // Show mobile floating CTA after scrolling past the first screen
  const fab = document.getElementById('mobileFabCta');
  if (fab) {
    let lastScrollY = 0;
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      // Show after scrolling 600px (roughly past the intro + first table)
      if (scrollY > 600) {
        fab.classList.add('visible');
      } else {
        fab.classList.remove('visible');
      }
      lastScrollY = scrollY;
    }, { passive: true });
  }
</script>
