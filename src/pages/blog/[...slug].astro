---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';
import { articleCta } from '../../data/homepage';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, pubDate, updatedDate, coverImage, coverAlt, tags, author, readingTime } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siteUrl = 'https://luneastertravel.com';
const articleUrl = `${siteUrl}/blog/${post.slug}`;

// Get the sidebar & end-CTA products from CMS-editable config (not hardcoded)
const sidebarProduct = products.find(p => p.slug === articleCta.sidebar.product_slug) || products[0];
const endRecommendation = products.find(p => p.slug === articleCta.end_cta.product_slug) || products[0];
const sidebarCfg = articleCta.sidebar;
const endCtaCfg = articleCta.end_cta;

// JSON-LD structured data for SEO
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'LuneAster Travel',
    url: siteUrl,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  url: articleUrl,
  keywords: tags.join(', '),
};
---

<Layout title={title} description={description} ogImage={coverImage}>
  <article class="article">
    <div class="article-layout">
      <!-- Main article column -->
      <div class="article-main">
        <a href="/blog" class="back-link">&larr; All Articles</a>

        <header class="article-header">
          {tags && tags.length > 0 && (
            <div class="article-tags">
              {tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          )}
          <h1>{title}</h1>
          <div class="article-meta">
            <span class="meta-author">{author}</span>
            <span class="meta-sep">&middot;</span>
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            {readingTime && (
              <>
                <span class="meta-sep">&middot;</span>
                <span class="meta-reading">{readingTime}</span>
              </>
            )}
          </div>
        </header>

        {coverImage && (
          <div class="article-cover">
            <img src={coverImage} alt={coverAlt || title} loading="eager" />
          </div>
        )}

        <!-- Affiliate disclosure banner (right after cover, before article body) -->
        <div class="affiliate-banner">
          <strong>Quick note:</strong> This article contains hand-picked affiliate links for hotels, transport passes, and tours. If you book through them, we earn a small commission at no extra cost to you &mdash; it keeps these guides free.
        </div>

        <div class="article-body">
          <Content />
        </div>

        <!-- End-of-article conversion block with direct Gumroad link -->
        <div class="article-end-cta">
          <div class="end-cta-label">{endCtaCfg.label}</div>
          <div class="end-cta-product">
            <div class="end-cta-info">
              <h3>{endRecommendation.title}</h3>
              <p>{endRecommendation.subtitle}</p>
              <div class="end-cta-meta">
                <span class="end-cta-price">{endRecommendation.priceLabel}</span>
                <span class="end-cta-pages">{endRecommendation.pages} pages</span>
                {endRecommendation.badge && <span class="end-cta-badge">{endRecommendation.badge}</span>}
              </div>
            </div>
            <a href={endRecommendation.gumroadUrl} class="end-cta-btn" target="_blank" rel="noopener">
              {endCtaCfg.cta_text}
            </a>
          </div>
          <a href={endCtaCfg.secondary_url} class="end-cta-secondary">{endCtaCfg.secondary_text}</a>
        </div>

        <div class="article-disclosure">
          Some links in this article are affiliate links. If you book through them, we earn a small commission at no extra cost to you. This helps us keep creating free travel content.
        </div>
      </div>

      <!-- Sticky sidebar with persistent product card (desktop only) -->
      <aside class="article-sidebar">
        <div class="sidebar-sticky">
          <div class="sidebar-product-card">
            <div class="sidebar-card-label">{sidebarCfg.label}</div>
            <h4>{sidebarProduct.title}</h4>
            <p class="sidebar-card-sub">{sidebarProduct.subtitle}</p>
            <div class="sidebar-card-price">
              <span class="price">{sidebarProduct.priceLabel}</span>
              {sidebarProduct.badge && <span class="sidebar-badge">{sidebarProduct.badge}</span>}
            </div>
            <ul class="sidebar-features">
              {sidebarProduct.features.slice(0, 3).map(f => <li>{f}</li>)}
            </ul>
            <a href={sidebarProduct.gumroadUrl} class="sidebar-cta" target="_blank" rel="noopener">
              {sidebarCfg.cta_text}
            </a>
            <div class="sidebar-trust">{sidebarCfg.trust_text}</div>
          </div>

          <div class="sidebar-newsletter">
            <h4>{sidebarCfg.newsletter_heading}</h4>
            <p>{sidebarCfg.newsletter_body}</p>
            <a href={sidebarCfg.newsletter_url} target="_blank" rel="noopener" class="sidebar-tiktok">
              {sidebarCfg.newsletter_cta}
            </a>
          </div>
        </div>
      </aside>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<style>
  .article {
    padding: 1.5rem 1.5rem 4rem;
  }

  .article-layout {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    gap: 3rem;
    align-items: flex-start;
  }

  .article-main {
    flex: 1;
    min-width: 0;
    max-width: 760px;
  }

  .back-link {
    display: inline-block;
    color: var(--c-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    transition: color var(--t-fast);
  }

  .back-link:hover {
    color: var(--c-accent);
  }

  .article-header {
    margin-bottom: 1.5rem;
  }

  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .tag {
    background: var(--c-accent-bg);
    color: var(--c-accent);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .article-header h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--c-text);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-text-muted);
    font-size: 0.875rem;
    flex-wrap: wrap;
  }

  .meta-sep {
    opacity: 0.5;
  }

  .article-cover {
    margin: 0 -1rem 1.5rem;
    border-radius: 12px;
    overflow: hidden;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16/9;
    object-fit: cover;
  }

  /* Affiliate disclosure banner */
  .affiliate-banner {
    background: var(--c-accent-bg);
    border-left: 3px solid var(--c-accent);
    padding: 0.875rem 1.25rem;
    border-radius: 8px;
    font-size: 0.85rem;
    color: var(--c-text-muted);
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .affiliate-banner strong {
    color: var(--c-accent);
    font-weight: 700;
  }

  .article-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--c-text);
  }

  .article-body :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2.5rem 0 1rem;
    color: var(--c-text);
  }

  .article-body :global(h3) {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    color: var(--c-text);
  }

  .article-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.25rem 1.5rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--c-accent);
    padding: 0.5rem 0 0.5rem 1.25rem;
    margin: 1.5rem 0;
    color: var(--c-text-muted);
    font-style: italic;
  }

  .article-body :global(strong) {
    font-weight: 700;
    color: var(--c-text);
  }

  .article-body :global(img) {
    border-radius: 8px;
    margin: 1.5rem 0;
    max-width: 100%;
    height: auto;
  }

  .article-body :global(a) {
    color: var(--c-accent);
    text-decoration: underline;
    text-decoration-color: rgba(232, 93, 74, 0.3);
    text-underline-offset: 3px;
  }

  .article-body :global(a:hover) {
    text-decoration-color: var(--c-accent);
  }

  /* End-of-article conversion block */
  .article-end-cta {
    margin: 3rem 0 1.5rem;
    padding: 1.75rem;
    background: linear-gradient(135deg, var(--c-accent-bg) 0%, rgba(255,255,255,0.5) 100%);
    border: 1px solid var(--c-border);
    border-radius: 16px;
  }

  .end-cta-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-accent);
    margin-bottom: 1rem;
  }

  .end-cta-product {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .end-cta-info h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--c-text);
    margin-bottom: 0.25rem;
  }

  .end-cta-info p {
    color: var(--c-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .end-cta-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .end-cta-price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--c-accent);
  }

  .end-cta-pages {
    font-size: 0.8rem;
    color: var(--c-text-muted);
  }

  .end-cta-badge {
    background: var(--c-accent);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 99px;
    text-transform: uppercase;
  }

  .end-cta-btn {
    display: inline-flex;
    align-items: center;
    background: var(--c-accent);
    color: white !important;
    padding: 0.875rem 1.75rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: 1rem;
    white-space: nowrap;
    transition: all var(--t-fast);
    min-height: 48px;
  }

  .end-cta-btn:hover {
    background: var(--c-accent-light);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(217, 74, 56, 0.35);
  }

  .end-cta-secondary {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--c-text-muted);
    font-weight: 500;
    transition: color var(--t-fast);
  }

  .end-cta-secondary:hover {
    color: var(--c-accent);
  }

  .article-disclosure {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    line-height: 1.5;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
  }

  /* Sidebar */
  .article-sidebar {
    display: none;
    width: 300px;
    flex-shrink: 0;
  }

  .sidebar-sticky {
    position: sticky;
    top: 90px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-product-card {
    background: white;
    border: 1px solid var(--c-border);
    border-radius: 14px;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .sidebar-card-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-accent);
    margin-bottom: 0.75rem;
  }

  .sidebar-product-card h4 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--c-text);
    margin-bottom: 0.25rem;
  }

  .sidebar-card-sub {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    margin-bottom: 0.75rem;
  }

  .sidebar-card-price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .sidebar-card-price .price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--c-accent);
  }

  .sidebar-badge {
    background: var(--c-accent);
    color: white;
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
    text-transform: uppercase;
  }

  .sidebar-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem 0;
    font-size: 0.82rem;
    color: var(--c-text-muted);
    line-height: 1.5;
  }

  .sidebar-features li {
    padding-left: 1.25rem;
    position: relative;
    margin-bottom: 0.4rem;
  }

  .sidebar-features li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--c-accent);
    font-weight: 700;
  }

  .sidebar-cta {
    display: block;
    text-align: center;
    background: var(--c-accent);
    color: white !important;
    padding: 0.75rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.9rem;
    transition: all var(--t-fast);
    min-height: 48px;
    line-height: 32px;
  }

  .sidebar-cta:hover {
    background: var(--c-accent-light);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(217, 74, 56, 0.3);
  }

  .sidebar-trust {
    text-align: center;
    font-size: 0.72rem;
    color: var(--c-text-muted);
    margin-top: 0.75rem;
  }

  .sidebar-newsletter {
    background: var(--c-accent-bg);
    border-radius: 14px;
    padding: 1.25rem;
    text-align: center;
  }

  .sidebar-newsletter h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--c-text);
    margin-bottom: 0.5rem;
  }

  .sidebar-newsletter p {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    margin-bottom: 0.75rem;
  }

  .sidebar-tiktok {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-accent);
    text-decoration: none;
  }

  .sidebar-tiktok:hover {
    text-decoration: underline;
  }

  /* Desktop: show sidebar */
  @media (min-width: 1024px) {
    .article-sidebar {
      display: block;
    }
  }

  /* Tablet: cover without negative margin */
  @media (min-width: 768px) {
    .article-cover {
      margin: 0 0 2rem;
    }
  }

  /* Mobile optimizations */
  @media (max-width: 640px) {
    .article {
      padding: 1rem 1rem 3rem;
    }

    .article-end-cta {
      padding: 1.25rem;
    }

    .end-cta-product {
      flex-direction: column;
      align-items: stretch;
    }

    .end-cta-btn {
      text-align: center;
      justify-content: center;
    }

    .affiliate-banner {
      font-size: 0.8rem;
      padding: 0.75rem 1rem;
    }
  }
</style>
