---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getImgInfo, getImgInfoBatch } from '../../utils/images';

// Filter to English-only articles (hide Chinese content from international visitors)
const isEnglish = (s: string) => /^[\x00-\x7F]*$/.test(s);

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter(p => isEnglish(p.data.title))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = allPosts.find(p => p.data.featured) || allPosts[0];
const rest = allPosts.filter(p => p !== featured);

// Pre-compute image info for WebP + dimensions
const featuredImgInfo = await getImgInfo(featured?.data.coverImage);
const restImgInfo = await getImgInfoBatch(rest.map(p => p.data.coverImage));
---

<Layout
  title="Japan Travel Blog — Free Guides & Tips"
  description="Free Japan travel articles, itinerary ideas, budget tips, and local secrets. Plan your trip with our in-depth guides."
>
  <section class="blog-hero">
    <div class="container">
      <h1>Japan Travel Blog</h1>
      <p>Free guides, itinerary ideas, and local tips to help you plan the perfect Japan trip.</p>
    </div>
  </section>

  <section class="blog-list">
    <div class="container">
      {allPosts.length === 0 ? (
        <div class="empty-state">
          <p>Articles coming soon. Check back shortly!</p>
        </div>
      ) : (
        <>
          {featured && (
            <a href={`/blog/${featured.slug}.html`} class="featured-card">
              {featured.data.coverImage && (
                <div class="featured-cover">
                  {featuredImgInfo.webp ? (
                    <picture>
                      <source srcset={featuredImgInfo.webp} type="image/webp" />
                      <img src={featured.data.coverImage} alt={featured.data.coverAlt || featured.data.title} loading="eager" width={featuredImgInfo.width} height={featuredImgInfo.height} />
                    </picture>
                  ) : (
                    <img src={featured.data.coverImage} alt={featured.data.coverAlt || featured.data.title} loading="eager" width={featuredImgInfo.width} height={featuredImgInfo.height} />
                  )}
                </div>
              )}
              <div class="featured-body">
                {featured.data.featured && <span class="featured-badge">Featured</span>}
                <h2>{featured.data.title}</h2>
                <p>{featured.data.description}</p>
                <div class="card-meta">
                  <time datetime={featured.data.pubDate.toISOString()}>
                    {featured.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                  </time>
                  {featured.data.readingTime && <span>· {featured.data.readingTime}</span>}
                </div>
              </div>
            </a>
          )}

          {rest.length > 0 && (
            <div class="post-grid">
              {rest.map((post, idx) => (
                <a href={`/blog/${post.slug}.html`} class="post-card">
                  {post.data.coverImage && (
                    <div class="post-cover">
                      {restImgInfo[idx]?.webp ? (
                        <picture>
                          <source srcset={restImgInfo[idx].webp} type="image/webp" />
                          <img src={post.data.coverImage} alt={post.data.coverAlt || post.data.title} loading="lazy" width={restImgInfo[idx]?.width} height={restImgInfo[idx]?.height} />
                        </picture>
                      ) : (
                        <img src={post.data.coverImage} alt={post.data.coverAlt || post.data.title} loading="lazy" width={restImgInfo[idx]?.width} height={restImgInfo[idx]?.height} />
                      )}
                    </div>
                  )}
                  <div class="post-body">
                    <div class="post-tags">
                      {post.data.tags.slice(0, 2).map(tag => <span class="tag">{tag}</span>)}
                    </div>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <div class="card-meta">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                      </time>
                      {post.data.readingTime && <span>· {post.data.readingTime}</span>}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          )}
        </>
      )}
    </div>
  </section>
</Layout>

<style>
  .blog-hero {
    padding: 3rem 1.5rem 2rem;
    text-align: center;
    background: linear-gradient(135deg, var(--c-accent-bg) 0%, transparent 100%);
  }

  .blog-hero h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: var(--c-text);
  }

  .blog-hero p {
    color: var(--c-text-muted);
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .blog-list {
    padding: 2rem 0 4rem;
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    margin-bottom: 2.5rem;
    transition: transform var(--t-fast), box-shadow var(--t-fast);
  }

  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .featured-cover {
    width: 100%;
    aspect-ratio: 21/9;
    overflow: hidden;
  }

  .featured-cover picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .featured-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-body {
    padding: 2rem;
  }

  .featured-badge {
    display: inline-block;
    background: var(--c-accent);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 0.75rem;
  }

  .featured-body h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--c-text);
  }

  .featured-body p {
    color: var(--c-text-muted);
    margin-bottom: 1rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--c-border);
    transition: transform var(--t-fast), box-shadow var(--t-fast);
  }

  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .post-cover {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .post-cover picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-body {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }

  .tag {
    background: var(--c-accent-bg);
    color: var(--c-accent);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 99px;
  }

  .post-body h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: var(--c-text);
    line-height: 1.3;
  }

  .post-body p {
    color: var(--c-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    flex: 1;
  }

  .card-meta {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    display: flex;
    gap: 0.4rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--c-text-muted);
  }

  @media (min-width: 768px) {
    .featured-card {
      flex-direction: row;
    }
    .featured-cover {
      width: 55%;
      aspect-ratio: auto;
    }
    .featured-body {
      width: 45%;
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
