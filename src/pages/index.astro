---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
import { getCollection } from 'astro:content';

// 本地图片：日本风景（Unsplash 下载到 public/images）
const heroImg = '/images/hero.jpg';
const galleryImgs = [
  { src: '/images/gallery-fuji.jpg', alt: 'Mount Fuji with cherry blossoms', label: 'Mt. Fuji' },
  { src: '/images/gallery-kyoto.jpg', alt: 'Kyoto street with traditional kimono', label: 'Kyoto' },
  { src: '/images/gallery-tokyo.jpg', alt: 'Tokyo Shinjuku at night', label: 'Tokyo' },
];

// 取最新 3 篇博客文章
const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout>
  <Header />

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg" style={`background-image: url('${heroImg}')`}></div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <span class="hero-tag">☽ Japan Travel Guides</span>
      <h1>Plan your Japan trip<br /><em>without the guesswork.</em></h1>
      <p class="hero-desc">
        Downloadable PDF guides with exact routes, budgets, and local tips.
        Built by a travel designer who's been there — not an AI scraping Reddit.
      </p>
      <div class="hero-cta">
        <a href="#products" class="btn btn-primary">
          Browse Guides
          <span>↓</span>
        </a>
        <a href="/resources" class="btn btn-secondary">Free Resources</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num">4</span>
          <span class="stat-label">Guides</span>
        </div>
        <div class="stat">
          <span class="stat-num">52</span>
          <span class="stat-label">Pages of content</span>
        </div>
        <div class="stat">
          <span class="stat-num">1M+</span>
          <span class="stat-label">TikTok views</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery Strip -->
  <section class="gallery-strip">
    {galleryImgs.map(img => (
      <div class="gallery-item">
        <img src={img.src} alt={img.alt} loading="lazy" />
        <span class="gallery-label">{img.label}</span>
      </div>
    ))}
  </section>

  <!-- Products Section -->
  <section class="section" id="products">
    <div class="container">
      <div class="section-header">
        <h2>Travel Guides</h2>
        <p>Each guide is a downloadable PDF — no app, no subscription, no ads.</p>
      </div>

      <div class="product-grid">
        {products.map(product => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <!-- Why Section -->
  <section class="section why-section">
    <div class="container">
      <div class="section-header">
        <h2>Why these guides work</h2>
        <p>Because they're built from real planning — not generic top-10 lists.</p>
      </div>
      <div class="why-grid">
        <div class="why-item">
          <div class="why-icon">🗺️</div>
          <h3>Exact Routes</h3>
          <p>Not "go to Shibuya" — but "Shibuya Crossing → 10 min walk → Harajuku via Takeshita Street." Minute-level planning.</p>
        </div>
        <div class="why-item">
          <div class="why-icon">¥</div>
          <h3>Real Budgets</h3>
          <p>Every activity, meal, and transport leg priced in yen. You'll know your total cost before you book.</p>
        </div>
        <div class="why-item">
          <div class="why-icon">🚄</div>
          <h3>Transport Demystified</h3>
          <p>JR Pass calculator, subway navigation, Shinkansen booking — the confusing stuff, simplified.</p>
        </div>
        <div class="why-item">
          <div class="why-icon">📍</div>
          <h3>Local Knowledge</h3>
          <p>Hotel areas that actually make sense. Restaurants where you won't need Google Translate.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  {recentPosts.length > 0 && (
    <section class="section blog-section">
      <div class="container">
        <div class="section-header">
          <h2>Free Travel Articles</h2>
          <p>In-depth guides and tips — no paywall, no fluff.</p>
        </div>
        <div class="blog-preview-grid">
          {recentPosts.map(post => (
            <a href={`/blog/${post.slug}`} class="blog-preview-card">
              <div class="blog-preview-tags">
                {post.data.tags.slice(0, 2).map(tag => <span class="tag">{tag}</span>)}
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="blog-preview-meta">
                <time>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</time>
                {post.data.readingTime && <span>· {post.data.readingTime}</span>}
              </div>
            </a>
          ))}
        </div>
        <div class="blog-cta">
          <a href="/blog" class="btn btn-secondary">Read All Articles →</a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="section cta-section">
    <div class="container-narrow cta-box">
      <h2>Not sure which guide you need?</h2>
      <p>Start with the 7-Day Japan Blueprint — it covers Tokyo, Hakone, Kyoto, and Osaka in one document. If you're only doing Tokyo, grab the 48hr Solo Route instead.</p>
      <a href="/products/japan-blueprint-7-day" class="btn btn-primary">Get the Blueprint →</a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(250, 248, 245, 0.92) 0%, rgba(250, 248, 245, 0.75) 50%, rgba(250, 248, 245, 0.5) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 6rem 1.5rem;
  }

  .hero-tag {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--c-accent);
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .hero h1 {
    margin-bottom: 1.5rem;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--c-accent);
    font-weight: 500;
  }

  .hero-desc {
    font-size: 1.15rem;
    max-width: 520px;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .hero-stats {
    display: flex;
    gap: 3rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-num {
    font-size: 2rem;
    font-weight: 700;
    color: var(--c-text);
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--c-text-muted);
  }

  /* Gallery Strip */
  .gallery-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    height: 280px;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-slow);
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .gallery-label {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    letter-spacing: 0.03em;
  }

  /* Section Header */
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header p {
    margin-top: 0.5rem;
  }

  /* Product Grid */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  /* Why Section */
  .why-section {
    background: var(--c-surface-light);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }

  .why-item {
    text-align: center;
    background: var(--c-surface);
    padding: 2rem 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--c-border);
    transition: all var(--t-normal);
  }

  .why-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .why-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .why-item h3 {
    margin-bottom: 0.5rem;
  }

  /* CTA */
  .cta-section {
    background: var(--c-surface);
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
  }

  .cta-box {
    text-align: center;
    padding: 3rem 1.5rem;
  }

  .cta-box h2 {
    margin-bottom: 1rem;
  }

  .cta-box p {
    margin-bottom: 2rem;
  }

  /* Blog Preview */
  .blog-section {
    background: var(--c-surface-light);
  }

  .blog-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .blog-preview-card {
    display: flex;
    flex-direction: column;
    background: var(--c-surface);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--c-border);
    transition: all var(--t-normal);
  }

  .blog-preview-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .blog-preview-tags {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .blog-preview-card .tag {
    background: var(--c-accent-bg);
    color: var(--c-accent);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 99px;
  }

  .blog-preview-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--c-text);
    line-height: 1.3;
  }

  .blog-preview-card p {
    color: var(--c-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    flex: 1;
    line-height: 1.5;
  }

  .blog-preview-meta {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    display: flex;
    gap: 0.4rem;
  }

  .blog-cta {
    text-align: center;
  }

  @media (max-width: 768px) {
    .gallery-strip {
      grid-template-columns: 1fr;
      height: auto;
    }

    .gallery-item {
      height: 200px;
    }
  }

  @media (max-width: 640px) {
    .hero-cta {
      flex-direction: column;
    }

    .hero-stats {
      gap: 2rem;
    }

    .stat-num {
      font-size: 1.5rem;
    }
  }
</style>
