---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Advantages from '../components/Advantages.astro';
import BlogSection from '../components/BlogSection.astro';
import TravelEssentials from '../components/TravelEssentials.astro';
import PremiumSection from '../components/PremiumSection.astro';
import CtaSection from '../components/CtaSection.astro';
import { sections } from '../data/homepage';

// Build the render map: module id → component
const moduleMap: Record<string, any> = {
  hero: Hero,
  advantages: Advantages,
  blog: BlogSection,
  essentials: TravelEssentials,
  premium: PremiumSection,
  cta: CtaSection,
};

// Get visible modules in order
const visibleModules = sections.filter(s => s.visible && moduleMap[s.id]);
---

<Layout preloadImage="/images/hero.webp">
  {visibleModules.map(mod => {
    const Component = moduleMap[mod.id];
    return <Component />;
  })}
</Layout>
