---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCta from '../components/FloatingCta.astro';
import { GA4_MEASUREMENT_ID } from '../utils/tracking';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  preloadImage?: string;
}

const {
  title = 'LuneAster Travel — Japan Travel Guides & Itineraries',
  description = 'Downloadable Japan travel guides, itineraries, and budget breakdowns. Plan your perfect Japan trip with LuneAster.',
  ogImage = '/images/og-default.jpg',
  preloadImage,
} = Astro.props;

const siteUrl = 'https://luneastertravel.com';
const fullTitle = title.includes('LuneAster') ? title : `${title} — LuneAster Travel`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />

  <!-- Favicon (用真实 logo 图) -->
  <link rel="icon" type="image/png" href="/logo.png" />

  <!-- Preload hero image for LCP optimization (homepage only) -->
  {preloadImage && <link rel="preload" as="image" href={preloadImage} type="image/webp" />}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <title>{fullTitle}</title>

  <!-- GA4 (Google Analytics 4) -->
  {GA4_MEASUREMENT_ID !== 'G-XXXXXXXXXX' && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`} />
      <script is:inline define:vars={{ GA4_MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', GA4_MEASUREMENT_ID, {
          send_page_view: true,
          link_attribution: true,
        });
      </script>
    </>
  )}
</head>
<body>
  <Header />
  <slot />
  <Footer />
  <FloatingCta />

  <!-- Outbound link click tracking (GA4 custom events) -->
  <script is:inline>
    (function() {
      document.addEventListener('click', function(e) {
        var link = e.target.closest('a');
        if (!link || !link.href) return;

        var href = link.href;
        var hostname = link.hostname;
        var currentHost = window.location.hostname;

        // 只追踪外链（排除本站链接和 javascript:void(0)）
        if (hostname === currentHost || hostname === '' ) return;

        // 判断链接类型
        var linkType = 'other';
        if (hostname.includes('gumroad.com')) linkType = 'gumroad';
        else if (hostname.includes('klook.com')) linkType = 'klook';
        else if (hostname.includes('amazon.com') || hostname.includes('amazon.')) linkType = 'amazon';
        else if (hostname.includes('aviasales.com')) linkType = 'aviasales';
        else if (hostname.includes('booking.com')) linkType = 'booking';
        else if (hostname.includes('awin1.com') || hostname.includes('gowithguide.com')) linkType = 'awin_gowithguide';
        else if (hostname.includes('instagram.com')) linkType = 'instagram';
        else if (hostname.includes('tiktok.com')) linkType = 'tiktok';

        // 提取 utm_content（如果有）
        var urlParams = new URLSearchParams(link.search);
        var utmContent = urlParams.get('utm_content') || '';

        if (typeof gtag === 'function') {
          gtag('event', 'outbound_click', {
            'link_type': linkType,
            'link_url': href,
            'link_domain': hostname,
            'utm_content': utmContent,
            'outbound': true,
          });
        }
      }, true);
    })();
  </script>

  <!-- Affiliate Disclosure (global) -->
  <style is:global>
    .footer-disclosure {
      font-size: 0.78rem;
      color: var(--c-text-muted);
      text-align: center;
      padding: var(--space-lg) var(--space-md);
      border-top: 1px solid var(--c-border);
      max-width: 700px;
      margin: 0 auto;
      line-height: 1.5;
    }
  </style>
</body>
</html>
